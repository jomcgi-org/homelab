# Vendored Playwright chromium for the hermetic visual-regression spike (ADR
# tooling/010). playwright_version MUST match the @playwright/test pinned in
# pnpm-lock.yaml (1.58.2, already vendored via projects/hikes/frontend), so the
# browser build and the driver agree. integrity_path_map (pinned download
# hashes) is intentionally omitted for the spike; pin it before productionizing.
playwright = use_extension("@rules_playwright//playwright:extensions.bzl", "playwright")
playwright.repo(
    name = "playwright",
    # rules_playwright 0.5.3 defaults to playwright.azureedge.net, which
    # Microsoft deprecated: it 400/404s for current chromium revisions (CI log
    # showed rev 1208 missing there). The live CDN is cdn.playwright.dev; the
    # rule appends /builds/chromium/<rev>/... and Bazel follows the 307 to the
    # blob backend.
    browsers_download_urls = ["https://cdn.playwright.dev/dbazure/download/playwright"],
    # 1.55.0 (chromium rev 1187), not the workspace's 1.58.2: rules_playwright
    # 0.5.3's bundled CLI generates the pre-1.58 x64 path (chromium-linux.zip),
    # and Playwright 1.58.2's chromium rev 1208 x64 blob 400s on the live CDN
    # while 1148/1187 download cleanly. Driver and browser must share a version,
    # so the spike package pins @playwright/test to 1.55.0 too.
    playwright_version = "1.55.0",
)
use_repo(playwright, "playwright")

