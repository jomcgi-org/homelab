# OCaml ruleset (bazel/ocaml) — thin native rules driving ocamlopt over a
# hermetic OCaml sysroot. The extension fetches the Semgrep OCaml fork *source*;
# //bazel/ocaml/toolchain:ocaml_compiler builds it as an RBE action (so binaries
# link the executor's glibc) into a sysroot staged as action inputs.
ocaml_source_ext = use_extension("//bazel/ocaml/toolchain:repositories.bzl", "ocaml_source")
use_repo(ocaml_source_ext, "ocaml_source")

