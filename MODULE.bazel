# Per-arch OCaml toolchains (ADR 006), one per enabled arch in
# bazel/ocaml/toolchain/arches.bzl (keep this list in sync when flipping an
# arch). Constrained only, deliberately no unconstrained fallback: execution
# platform priority dominates toolchain registration order, so a fallback that
# matches any target platform always wins from the default (amd64) executor
# platform and silently produces foreign-arch binaries for aarch64 targets
# (Exec format error at test time).
register_toolchains(
    "//bazel/ocaml:ocaml_toolchain_linux_x86_64",
    "//bazel/ocaml:ocaml_toolchain_linux_aarch64",
)

# The arm64 platform must be a registered execution platform for toolchain
# resolution to schedule ocaml actions on the arm64 pool. Flag-supplied
# platforms (bazel/remote.bazelrc --extra_execution_platforms, the default
# amd64 RBE platform) take precedence over this registration, so builds that
# never select aarch64 are unaffected.
register_execution_platforms("//bazel/ocaml/platforms:linux_aarch64")

