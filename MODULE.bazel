# Go
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

# Download an SDK for the host OS & architecture as well as common remote execution
# platforms, using the version given from the `go.mod` file.
go_sdk.from_file(go_mod = "//:go.mod")
go_sdk.nogo(nogo = "//bazel/tools/lint:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# The guest runs the same bzlmod repository mapping as //:gazelle.
use_repo(go_deps, "bazel_gazelle_go_repository_config")

# Fix for konnectivity-client proto generation issue
# Use the upstream BUILD files instead of gazelle-generated ones
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable",
    ],
    path = "sigs.k8s.io/apiserver-network-proxy/konnectivity-client",
)

# go-spiffe ships pre-generated .pb.go files for proto/spiffe/workload; gazelle
# otherwise generates a go_proto_library from workload.proto and the checked-in
# workload_grpc.pb.go fails to compile against it (undefined: X509SVIDRequest).
# Treat the checked-in .pb.go as ordinary Go sources.
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable",
    ],
    path = "github.com/spiffe/go-spiffe/v2",
)

# All *direct* Go dependencies of the module have to be listed explicitly.
# Run 'bazel mod tidy' to update this.
# org_golang_google_grpc_cmd_protoc_gen_go_grpc was kept for the EmberVM
# node.proto codegen, deleted with the hub (HOME-262). `bazel mod tidy` may drop it.
use_repo(go_deps, "com_github_bazelbuild_buildtools", "com_github_betterleaks_betterleaks_v2", "com_github_envoyproxy_go_control_plane", "com_github_envoyproxy_go_control_plane_envoy", "com_github_go_jose_go_jose_v4", "com_github_go_logr_logr", "com_github_google_go_containerregistry", "com_github_google_uuid", "com_github_klauspost_compress", "com_github_lib_pq", "com_github_onsi_ginkgo_v2", "com_github_onsi_gomega", "com_github_prometheus_client_golang", "com_github_spf13_cobra", "com_github_spf13_viper", "com_github_spiffe_go_spiffe_v2", "com_github_stretchr_testify", "com_github_yuin_goldmark", "com_github_zricethezav_gitleaks_v8", "in_gopkg_yaml_v3", "io_k8s_api", "io_k8s_apimachinery", "io_k8s_client_go", "io_k8s_sigs_controller_runtime", "io_k8s_sigs_yaml", "io_k8s_utils", "io_nhooyr_websocket", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracegrpc", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_trace", "org_golang_google_genproto_googleapis_rpc", "org_golang_google_grpc", "org_golang_google_grpc_cmd_protoc_gen_go_grpc", "org_golang_google_protobuf", "org_golang_x_net", "org_golang_x_sync", "org_golang_x_sys", "org_golang_x_time")

