{{ template "base" . }}

# gVisor runtime handler for the `gvisor` RuntimeClass
# (projects/platform-factory/runtimeclasses). install-node.sh installs the
# pinned runsc and containerd-shim-runsc-v1 to /usr/local/bin.
#
# Agent Substrate does not use this handler: its atelet downloads the gVisor
# release named in its own SandboxConfig and runs it inside worker pods.
[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runsc]
  runtime_type = "io.containerd.runsc.v1"
