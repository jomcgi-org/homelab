#!/usr/sbin/nft -f
# Host firewall for the factory home nodes (HOME-367).
#
# Only the three nodes, pods and the tailnet reach host ports, each on
# the interface it uses. Other LAN hosts get nothing. The table is separate from the iptables-nft tables
# that k3s and Cilium own, so loading or deleting it never touches theirs.
# Pod traffic is forwarded, not input, and Cilium's BPF handles it before
# netfilter, so this filters host-network listeners only.
#
# Roll back on a node: sudo systemctl stop factory-firewall

table inet factory_fw
delete table inet factory_fw

table inet factory_fw {
	set nodes {
		type ipv4_addr
		elements = { 192.168.4.80, 192.168.4.81, 192.168.4.76 }
	}

	chain input {
		type filter hook input priority filter; policy drop;

		ct state established,related accept
		ct state invalid drop
		iifname "lo" accept

		# Node to node on the NIC. Cilium WireGuard (UDP 51871) carries most
		# of it, authenticated by peer keys. Each TCP port below authenticates
		# its peer: etcd, apiserver, kubelet and the k3s registry by cluster
		# mTLS, SSH by key; Cilium health (4240) answers only health probes.
		# Metrics and Hubble ports are not here: pods reach them through
		# Cilium interfaces. Measured 2026-11-18: etcd peer, apiserver,
		# health and SSH only.
		iifname "enp*" ip saddr @nodes udp dport 51871 accept
		iifname "enp*" ip saddr @nodes tcp dport { 22, 2379, 2380, 4240, 5001, 6443, 10250 } accept

		# Decrypted WireGuard traffic and pods arrive on Cilium interfaces.
		iifname { "cilium_*", "lxc*" } accept

		# Tailnet (node-1 only has it): SSH, kubectl, workstation access.
		# Tailscale's own UDP is outbound-first, so conntrack admits replies.
		iifname "tailscale0" accept

		# ICMP errors for live connections (unreachable, packet too big,
		# time exceeded) arrive as ct related above. Only nodes may ping.
		# IPv6 neighbour discovery and router advertisements must come
		# from the link itself: hop limit 255, as RFC 4861 requires.
		ip saddr @nodes icmp type echo-request accept
		iifname "enp*" ip6 hoplimit 255 icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } accept
		iifname "enp*" ip6 saddr fe80::/10 ip6 hoplimit 255 icmpv6 type nd-router-advert accept

		# DHCPv4 replies from the LAN router, the nodes' only DHCP server.
		# IPv6 addresses come from router advertisements, not DHCPv6.
		iifname "enp*" ip saddr 192.168.4.1 udp sport 67 udp dport 68 accept
	}
}
