{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jomcgi.dev/factory-storyboard/schema/v1/snapshot.schema.json",
  "title": "Factory storyboard snapshot v1",
  "description": "All text is plain text. Links are constructed from typed identifiers. Manifest is mutable; every other object is addressed by SHA-256 of its exact UTF-8 bytes.",
  "oneOf": [
    {
      "$ref": "#/definitions/manifest"
    },
    {
      "$ref": "#/definitions/story"
    },
    {
      "$ref": "#/definitions/goal"
    },
    {
      "$ref": "#/definitions/issue"
    },
    {
      "$ref": "#/definitions/session"
    }
  ],
  "definitions": {
    "text": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "issueKey": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[1-9][0-9]*$"
    },
    "path": {
      "type": "string",
      "pattern": "^objects/[a-f0-9]{64}\\.json$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "state": {
      "enum": [
        "Working",
        "In review",
        "In merge queue",
        "Shipped",
        "Stopped"
      ]
    },
    "narrative": {
      "type": "string",
      "description": "Plain text. Numeric claims use {{stat:key}} only; literal decimal digits outside placeholders are forbidden.",
      "pattern": "^(?:[^0-9{}]|\\{\\{stat:[a-z][a-zA-Z0-9_]*\\}\\})*$"
    },
    "stat": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "issues",
            "goals",
            "hours",
            "rounds",
            "%"
          ]
        }
      },
      "required": [
        "label",
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "ratePoint": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "goalSummary": {
      "type": "object",
      "properties": {
        "goalId": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "type": "string"
        },
        "chapter": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/narrative"
          }
        },
        "state": {
          "$ref": "#/definitions/state"
        },
        "shipped": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "goalId",
        "title",
        "chapter",
        "state",
        "shipped",
        "total"
      ],
      "additionalProperties": false
    },
    "issueSummary": {
      "type": "object",
      "properties": {
        "issueKey": {
          "$ref": "#/definitions/issueKey"
        },
        "goalId": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/state"
        }
      },
      "required": [
        "issueKey",
        "goalId",
        "title",
        "state"
      ],
      "additionalProperties": false
    },
    "burnPoint": {
      "type": "object",
      "properties": {
        "date": {
          "$ref": "#/definitions/date"
        },
        "shipped": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "date",
        "shipped",
        "total"
      ],
      "additionalProperties": false
    },
    "toolCall": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "input",
        "output"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "generatedAt": {
          "$ref": "#/definitions/time"
        },
        "story": {
          "$ref": "#/definitions/path"
        },
        "goals": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/id"
          },
          "additionalProperties": {
            "$ref": "#/definitions/path"
          }
        },
        "issues": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/issueKey"
          },
          "additionalProperties": {
            "$ref": "#/definitions/path"
          }
        },
        "sessions": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/id"
          },
          "additionalProperties": {
            "$ref": "#/definitions/path"
          }
        }
      },
      "required": [
        "version",
        "generatedAt",
        "story",
        "goals",
        "issues",
        "sessions"
      ],
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "story"
        },
        "headline": {
          "$ref": "#/definitions/narrative"
        },
        "notice": {
          "type": "string"
        },
        "narrative": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/narrative"
          }
        },
        "stats": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/stat"
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/goalSummary"
          }
        },
        "workInProgress": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/issueSummary"
          }
        },
        "recentlyShipped": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/issueSummary"
          }
        },
        "charts": {
          "type": "object",
          "properties": {
            "shippedPerWeek": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/point"
              }
            },
            "issueToMergeHours": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/point"
              }
            },
            "reviewRounds": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/point"
              }
            },
            "firstPassReviewRate": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ratePoint"
              }
            }
          },
          "required": [
            "shippedPerWeek",
            "issueToMergeHours",
            "reviewRounds",
            "firstPassReviewRate"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "kind",
        "headline",
        "notice",
        "narrative",
        "stats",
        "goals",
        "workInProgress",
        "recentlyShipped",
        "charts"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "goal"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/state"
        },
        "chapter": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/narrative"
          }
        },
        "issueKeys": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/issueKey"
          },
          "uniqueItems": true
        },
        "burnUp": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/burnPoint"
          }
        }
      },
      "required": [
        "version",
        "kind",
        "id",
        "title",
        "state",
        "chapter",
        "issueKeys",
        "burnUp"
      ],
      "additionalProperties": false
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "opened"
            },
            "at": {
              "$ref": "#/definitions/time"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "session"
            },
            "at": {
              "$ref": "#/definitions/time"
            },
            "text": {
              "type": "string"
            },
            "sessionId": {
              "$ref": "#/definitions/id"
            },
            "turn": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "at",
            "text",
            "sessionId",
            "turn"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "pullRequest"
            },
            "at": {
              "$ref": "#/definitions/time"
            },
            "text": {
              "type": "string"
            },
            "prNumber": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "at",
            "text",
            "prNumber"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "review"
            },
            "at": {
              "$ref": "#/definitions/time"
            },
            "text": {
              "type": "string"
            },
            "prNumber": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "round": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "outcome": {
              "enum": [
                "Changes requested",
                "Approved"
              ]
            }
          },
          "required": [
            "kind",
            "at",
            "text",
            "prNumber",
            "round",
            "outcome"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "check"
            },
            "at": {
              "$ref": "#/definitions/time"
            },
            "text": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "result": {
              "enum": [
                "Passed",
                "Failed"
              ]
            }
          },
          "required": [
            "kind",
            "at",
            "text",
            "name",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "mergeQueue"
            },
            "at": {
              "$ref": "#/definitions/time"
            },
            "text": {
              "type": "string"
            },
            "state": {
              "enum": [
                "Entered",
                "Left"
              ]
            }
          },
          "required": [
            "kind",
            "at",
            "text",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "merged"
            },
            "at": {
              "$ref": "#/definitions/time"
            },
            "text": {
              "type": "string"
            },
            "prNumber": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "at",
            "text",
            "prNumber"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "stopped"
            },
            "at": {
              "$ref": "#/definitions/time"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "text"
          ],
          "additionalProperties": false
        }
      ]
    },
    "issue": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "issue"
        },
        "key": {
          "$ref": "#/definitions/issueKey"
        },
        "goalId": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/state"
        },
        "description": {
          "type": "string"
        },
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/event"
          }
        }
      },
      "required": [
        "version",
        "kind",
        "key",
        "goalId",
        "title",
        "state",
        "description",
        "timeline"
      ],
      "additionalProperties": false
    },
    "turn": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "at": {
              "$ref": "#/definitions/time"
            },
            "role": {
              "enum": [
                "user",
                "assistant"
              ]
            },
            "withheld": {
              "const": true
            }
          },
          "required": [
            "number",
            "at",
            "role",
            "withheld"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "at": {
              "$ref": "#/definitions/time"
            },
            "role": {
              "enum": [
                "user",
                "assistant"
              ]
            },
            "withheld": {
              "const": false
            },
            "text": {
              "type": "string"
            },
            "toolCalls": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/toolCall"
              }
            },
            "diff": {
              "type": "string"
            }
          },
          "required": [
            "number",
            "at",
            "role",
            "withheld",
            "text",
            "toolCalls"
          ],
          "additionalProperties": false
        }
      ]
    },
    "session": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "session"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "issueKey": {
          "$ref": "#/definitions/issueKey"
        },
        "goalId": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/state"
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/turn"
          }
        }
      },
      "required": [
        "version",
        "kind",
        "id",
        "issueKey",
        "goalId",
        "title",
        "state",
        "turns"
      ],
      "additionalProperties": false
    }
  }
}
