index 0000000..141d359
--- /dev/null
+++ b/term_js.go
@@ -0,0 +1,46 @@
+package term
+
+import (
+	"errors"
+	"io"
+	"os"
+)
+
+type terminalState struct{}
+
+var errNoTerminal = errors.New("browser streams have no terminal")
+
+func stdStreams() (io.ReadCloser, io.Writer, io.Writer) { return os.Stdin, os.Stdout, os.Stderr }
+func getFdInfo(interface{}) (uintptr, bool)             { return 0, false }
+func isTerminal(uintptr) bool                           { return false }
+func getWinsize(fd uintptr) (*Winsize, error) {
+	return nil, errNoTerminal
+}
+
+func setWinsize(fd uintptr, ws *Winsize) error {
+	return errNoTerminal
+}
+
+func restoreTerminal(fd uintptr, state *State) error {
+	return errNoTerminal
+}
+
+func saveState(fd uintptr) (*State, error) {
+	return nil, errNoTerminal
+}
+
+func disableEcho(fd uintptr, state *State) error {
+	return errNoTerminal
+}
+
+func setRawTerminal(fd uintptr) (*State, error) {
+	return nil, errNoTerminal
+}
+
+func setRawTerminalOutput(uintptr) (*State, error) {
+	return nil, errNoTerminal
+}
+
+func makeRaw(fd uintptr) (*State, error) {
+	return nil, errNoTerminal
+}
