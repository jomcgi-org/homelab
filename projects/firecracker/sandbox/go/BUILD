# gazelle:ignore
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//bazel/tools/oci:apko_image.bzl", "apko_image")

# The Go language guest for the zero-egress code executor (ADR agents/057).
# A Wolfi apko base carrying only the Go toolchain, with the SHARED
# sandbox-guest-init as PID 1. Init resolves its language Spec from the
# /etc/sandbox-language file baked below, warms the toolchain so the warm-base
# snapshot captures it, then serves the shim protocol; each /invoke runs one
# snippet in a fresh workdir and returns.

# Bake /etc/environment.md, the guest's self-description (ADR agents/044). The
# file is COMMITTED and regenerated by run-generators.sh from the apko lock plus
# env-notes.md, so a lock change regenerates it and CI's format job auto-commits
# any drift.
pkg_tar(
    name = "environment_md_tar",
    srcs = ["environment.md"],
    mode = "0644",
    owner = "0.0",
    package_dir = "/etc",
)

# The language selector sandbox-guest-init reads once at startup to resolve its
# Spec. This one-line file is the ONLY thing that differs between the six
# language images besides their toolchain packages.
pkg_tar(
    name = "sandbox_language_tar",
    srcs = ["sandbox-language"],
    mode = "0644",
    owner = "0.0",
    package_dir = "/etc",
)

apko_image(
    name = "image",
    # amd64 only: see the `arm64` arg in apko_image.bzl.
    arm64 = False,
    config = "apko.yaml",
    contents = "@sandbox_go_lock//:contents",
    repository = "ghcr.io/jomcgi/homelab/projects/firecracker/sandbox/go",
    tars = [
        "//projects/firecracker/sandbox:guest_init_tar_amd64",
        ":environment_md_tar",
        ":sandbox_language_tar",
    ],
)
