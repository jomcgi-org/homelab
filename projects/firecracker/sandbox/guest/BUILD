# gazelle:ignore
load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//bazel/tools/oci:apko_image.bzl", "apko_image")

# The zero-egress python code-executor sandbox microVM image (ADR agents/044):
# a Wolfi apko base (python + the shared scientific library block, see
# apko.yaml) with sandbox-guest-init as PID 1. One-shot: init pre-imports the
# baked libraries so the warm-base snapshot captures their page cache, then
# serves the shim protocol; each /invoke runs one python snippet and returns.

# Bake /etc/environment.md, the guest's self-description (ADR agents/044).
# The file is COMMITTED and regenerated by run-generators.sh from the apko
# lock plus env-notes.md (same pipeline as the docs manifests), so a lock
# change regenerates it and CI's format job auto-commits any drift. Kept out
# of a genrule deliberately: py_venv_binary tools cannot run under genrule on
# RBE (no runfiles tree).
pkg_tar(
    name = "environment_md_tar",
    srcs = ["environment.md"],
    mode = "0644",
    owner = "0.0",
    package_dir = "/etc",
)

# Baked python helpers importable by executed code (ADR agents/044). Landed at
# /opt/sandbox, which the handler puts on PYTHONPATH; outside the per-invoke
# workdir so it is never collected as an output file. render_table lives here.
pkg_tar(
    name = "sandbox_tools_tar",
    srcs = ["sandbox_tools.py"],
    mode = "0644",
    owner = "0.0",
    package_dir = "/opt/sandbox",
)

# sandbox-guest-init binary, cross-compiled per arch and layered at
# /usr/local/bin.
platform_transition_filegroup(
    name = "sandbox_guest_init_amd64_bin",
    srcs = ["//projects/firecracker/sandbox/guest-init/cmd"],
    target_platform = "@rules_go//go/toolchain:linux_amd64",
)

tar(
    name = "sandbox_guest_init_tar_amd64",
    srcs = [":sandbox_guest_init_amd64_bin"],
    mtree = [
        "./usr/local/bin/sandbox-guest-init type=file content=$(execpath :sandbox_guest_init_amd64_bin) mode=0755 uid=0 gid=0",
    ],
)

apko_image(
    name = "image",
    # amd64 only: see the `arm64` arg in apko_image.bzl.
    arm64 = False,
    config = "apko.yaml",
    contents = "@sandbox_guest_lock//:contents",
    repository = "ghcr.io/jomcgi/homelab/projects/firecracker/sandbox/guest",
    tars = [
        ":sandbox_guest_init_tar_amd64",
        ":environment_md_tar",
        ":sandbox_tools_tar",
    ],
)
