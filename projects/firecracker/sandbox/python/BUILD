# gazelle:ignore
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//bazel/tools/oci:apko_image.bzl", "apko_image")

# The python language guest for the zero-egress code executor (ADR agents/044,
# ADR agents/057): a Wolfi apko base (python + the shared scientific library
# block, see apko.yaml) with sandbox-guest-init as PID 1. One-shot: init warms
# the baked libraries so the warm-base snapshot captures their page cache, then
# serves the shim protocol; each /invoke runs one snippet and returns.
#
# This package was `guest/` until ADR agents/057 added five sibling languages
# and the bare name stopped saying which one it was.

# Bake /etc/environment.md, the guest's self-description (ADR agents/044).
# The file is COMMITTED and regenerated by run-generators.sh from the apko
# lock plus env-notes.md (same pipeline as the docs manifests), so a lock
# change regenerates it and CI's format job auto-commits any drift. Kept out
# of a genrule deliberately: py_venv_binary tools cannot run under genrule on
# RBE (no runfiles tree).
pkg_tar(
    name = "environment_md_tar",
    srcs = ["environment.md"],
    mode = "0644",
    owner = "0.0",
    package_dir = "/etc",
)

# The language selector sandbox-guest-init reads once at startup to resolve its
# Spec. This one-line file is the ONLY thing that differs between the six
# language images besides their toolchain packages.
pkg_tar(
    name = "sandbox_language_tar",
    srcs = ["sandbox-language"],
    mode = "0644",
    owner = "0.0",
    package_dir = "/etc",
)

# Baked python helpers importable by executed code (ADR agents/044). Landed at
# /opt/sandbox, which the handler puts on PYTHONPATH; outside the per-invoke
# workdir so it is never collected as an output file. render_table lives here.
pkg_tar(
    name = "sandbox_tools_tar",
    srcs = ["sandbox_tools.py"],
    mode = "0644",
    owner = "0.0",
    package_dir = "/opt/sandbox",
)

apko_image(
    name = "image",
    # amd64 only: see the `arm64` arg in apko_image.bzl.
    arm64 = False,
    config = "apko.yaml",
    contents = "@sandbox_python_lock//:contents",
    repository = "ghcr.io/jomcgi/homelab/projects/firecracker/sandbox/python",
    tars = [
        "//projects/firecracker/sandbox:guest_init_tar_amd64",
        ":environment_md_tar",
        ":sandbox_language_tar",
        ":sandbox_tools_tar",
    ],
)
