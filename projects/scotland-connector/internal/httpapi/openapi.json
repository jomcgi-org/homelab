{
  "openapi": "3.1.0",
  "info": {
    "title": "Scotland outdoors API",
    "version": "v1",
    "summary": "Read-only answers to Scottish trip questions: which walks fit the weather and where the night sky will be dark and clear, with a go, marginal, no or unknown verdict.",
    "description": "Read-only plan and check endpoints plus a staged, default-off near-term aurora heuristic. Every response carries a provenance envelope (sources, attribution, forecast fetch time, method). Results and radius are capped; there is no bulk listing. Bulk extraction or redistribution of responses is not permitted.",
    "license": {
      "name": "Responses carry the source licences named in meta.sources"
    }
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/v1/light": {
      "get": {
        "operationId": "light",
        "security": [],
        "summary": "Light and night-sky windows at a Scottish point",
        "description": "Staged repository delivery pending operational acceptance. Astronomy is computed without upstream calls and remains available without a snapshot. Europe/London civil dates, today by default, three-day default span, seven-day maximum and no later than 13 days ahead. Windows are clipped to each civil date. Cloud verdicts describe supporting nearby-site clear twilight-dark hourly samples only. Missing observations, including golden/blue light, stay unknown. Night suitability is reported separately. Anonymous, cookie-free responses use plan's bounded browser and Cloudflare cache policies, including ETag validation; forecasts prevent permanent caching.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": 54.5, "maximum": 61 },
            "description": "Latitude, rounded to 0.01 degrees."
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": -9, "maximum": -0.5 },
            "description": "Longitude, degrees east, rounded to 0.01 degrees."
          },
          {
            "name": "radius_km",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            },
            "description": "Site search ceiling; effective reach is min(radius_km,30) km. Nearest site wins, then ID for distance ties."
          },
          {
            "name": "from",
            "in": "query",
            "schema": { "type": "string", "format": "date" },
            "description": "Inclusive first Europe/London civil date, today by default, at most 13 days ahead."
          },
          {
            "name": "to",
            "in": "query",
            "schema": { "type": "string", "format": "date" },
            "description": "Inclusive last date, three-day default, seven-day maximum, no later than 13 days ahead."
          }
        ],
        "responses": {
          "200": {
            "description": "Astronomical windows and scoped cloud sample support; missing weather is an explained unknown.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "public, max-age=60, s-maxage=600, stale-while-revalidate=3600, stale-if-error=86400"
                }
              },
              "Cloudflare-CDN-Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "public, max-age=600, stale-while-revalidate=3600, stale-if-error=86400"
                }
              },
              "ETag": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LightResponse" }
              }
            }
          },
          "304": { "description": "Not modified (If-None-Match matched)." },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/v1/aurora": {
      "get": {
        "operationId": "aurora",
        "summary": "Check near-term aurora conditions at a supported Scottish site",
        "description": "Snapshot-only heuristic, default-off pending operational acceptance. NOAA support is its exact forecast instant; unsupported past/future instants return unknown. A site must be within 1 km with timestamped MET cloud and complete sampled northern terrain. Stale, missing or insufficient evidence returns unknown. This is not calibrated local sighting probability. Responses use no-store on browser and shared caches, with no stale fallback or ETag validation.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": 54.5, "maximum": 61 },
            "description": "Latitude in decimal degrees, not rounded for terrain identity."
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": -9, "maximum": -0.5 }
          },
          {
            "name": "at",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "maxLength": 40
            },
            "description": "Requested instant with timezone. Only NOAA's forecast_at instant is supported; there is no fixed 90-minute validity interval."
          }
        ],
        "responses": {
          "200": {
            "description": "Explained assessment, including unknown when disabled or unsupported",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string", "const": "no-store" }
              },
              "Cloudflare-CDN-Cache-Control": {
                "schema": { "type": "string", "const": "no-store" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuroraResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/v1/plan": {
      "get": {
        "operationId": "plan",
        "summary": "What to do near a place over the next few days",
        "description": "For each day from `from` to `to`: sunrise, sunset and the moon at the point, then the walks that fit the weather and the night's best stargazing within radius_km, each with a go or marginal verdict and a one-line why; when none suit, walk_note or stargazing_note says why. Walks are Walkhighlands routes whose start is within the radius and whose best good-weather slot fits their estimated time (80% of it in good hours, two hours of credit for walks over seven hours); go before marginal, then the longest slot, then the nearest. Stargazing sites are road-accessible points in the darkest light-pollution zones, ranked by clear dark hours weighted by the moon. Walk weather is forecast at each walk's start, not on summits.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": 54.5, "maximum": 61.0 },
            "description": "Latitude, decimal degrees. Rounded to 0.01."
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": -9.0, "maximum": -0.5 },
            "description": "Longitude, decimal degrees. Rounded to 0.01."
          },
          {
            "name": "radius_km",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": { "type": "string", "format": "date" },
            "description": "First day (UK date), from today up to 13 days ahead. A day's stargazing is the night of its evening; before 09:00 the night under way is yesterday's, which from may also be when stargazing is planned, and is by default. Otherwise the default is today."
          },
          {
            "name": "to",
            "in": "query",
            "schema": { "type": "string", "format": "date" },
            "description": "Last day; a plan covers at most 7 days. Default two days after today, or after from when that is later."
          },
          {
            "name": "activities",
            "in": "query",
            "schema": {
              "type": "array",
              "items": { "type": "string", "enum": ["walk", "stargaze"] }
            },
            "style": "form",
            "explode": false,
            "description": "Comma-separated or repeated. Default both."
          },
          {
            "name": "min_duration_h",
            "in": "query",
            "schema": { "type": "number", "minimum": 0.5, "maximum": 24 },
            "description": "Only walks whose estimated time is at least this many hours."
          },
          {
            "name": "max_duration_h",
            "in": "query",
            "schema": { "type": "number", "minimum": 0.5, "maximum": 24 },
            "description": "Only walks whose estimated time is at most this many hours."
          },
          {
            "name": "min_length_km",
            "in": "query",
            "schema": { "type": "number", "minimum": 0.5, "maximum": 100 },
            "description": "Only walks at least this long, in km."
          },
          {
            "name": "max_length_km",
            "in": "query",
            "schema": { "type": "number", "minimum": 0.5, "maximum": 100 },
            "description": "Only walks at most this long, in km."
          },
          {
            "name": "max_ascent_m",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 3000 },
            "description": "Only walks with at most this much ascent, in metres."
          },
          {
            "name": "max_rain_mm_h",
            "in": "query",
            "schema": { "type": "number", "minimum": 0, "maximum": 10 },
            "description": "Walks: an hour counts as good only with at most this much rain, in mm. 0 means dry; the default 2 allows light rain; higher accepts wetter hours."
          },
          {
            "name": "max_wind_kmh",
            "in": "query",
            "schema": { "type": "number", "minimum": 0, "maximum": 120 },
            "description": "Walks: an hour counts as good only with mean wind at most this, in km/h, at the walk's start. Default 80."
          },
          {
            "name": "min_temp_c",
            "in": "query",
            "schema": { "type": "number", "minimum": -30, "maximum": 30 },
            "description": "Walks: an hour counts as good only at or above this temperature, in degrees C. Default none."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 3
            },
            "description": "Options per activity per day."
          }
        ],
        "responses": {
          "200": {
            "description": "The plan, one entry per day.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanResponse" }
              }
            }
          },
          "304": { "description": "Not modified (If-None-Match matched)." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/check": {
      "post": {
        "operationId": "check",
        "summary": "Whether a plan is on",
        "description": "For each item (a walk on a date, or stargazing at a point on a night) a verdict and a one-line why, the timing (the walk's slot and start window, or the clear window at the best dark-sky site within 10 km, widening to 30 km), sunrise, sunset and the moon, the other forecast days that suit it, and better options nearby the same day. A walk is found by walk_id, or by walk_name (every word must start a word of the Walkhighlands name). An item that cannot be resolved carries error and no verdict; the others still answer. Answers are not cached; for a cacheable question use plan.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CheckRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One answer per item.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CheckResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/method": {
      "get": {
        "operationId": "method",
        "summary": "How the answers are computed",
        "responses": {
          "200": {
            "description": "Method description.",
            "content": { "text/markdown": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "openapi",
        "summary": "This document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document.",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Invalid parameter.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unavailable": {
        "description": "Forecast data not loaded yet.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "AuroraResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/AuroraAssessment" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "AuroraAssessment": {
        "type": "object",
        "required": ["verdict", "why", "at", "policy", "evidence"],
        "properties": {
          "verdict": { "$ref": "#/components/schemas/Verdict" },
          "why": { "type": "string" },
          "at": { "type": "string", "format": "date-time" },
          "policy": { "type": "string", "const": "aurora-point-v1" },
          "site_id": { "type": "string" },
          "site_lat": { "type": "number" },
          "site_lon": { "type": "number" },
          "distance_km": { "type": "number", "maximum": 1 },
          "evidence": {
            "type": "object",
            "required": ["noaa", "weather", "terrain", "darkness"],
            "additionalProperties": {
              "type": "object",
              "required": ["status", "why"],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["supported", "unknown"]
                },
                "why": { "type": "string" }
              }
            }
          },
          "noaa": {
            "type": "object",
            "required": [
              "observed_at",
              "forecast_at",
              "collected_at",
              "policy_expires_at",
              "support",
              "no_lead"
            ],
            "properties": {
              "observed_at": { "type": "string", "format": "date-time" },
              "forecast_at": { "type": "string", "format": "date-time" },
              "collected_at": { "type": "string", "format": "date-time" },
              "policy_expires_at": {
                "type": "string",
                "format": "date-time",
                "description": "Application collection freshness only; does not extend support."
              },
              "support": { "type": "string" },
              "no_lead": {
                "type": "boolean",
                "description": "Forecast and observation timestamps coincide. The payload does not identify the upstream forcing mode."
              }
            }
          },
          "weather": {
            "type": "object",
            "required": ["issued_at", "collected_at", "hours"],
            "properties": {
              "issued_at": { "type": "string", "format": "date-time" },
              "collected_at": { "type": "string", "format": "date-time" },
              "hours": {
                "type": "array",
                "maxItems": 96,
                "items": {
                  "type": "object",
                  "required": ["time", "cloud_pct"],
                  "properties": {
                    "time": { "type": "string", "format": "date-time" },
                    "cloud_pct": {
                      "type": ["number", "null"],
                      "minimum": 0,
                      "maximum": 100
                    }
                  }
                }
              }
            }
          },
          "terrain": {
            "type": ["object", "null"],
            "properties": {
              "source": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "algorithm": { "type": "string" },
              "north_deg": {
                "type": "array",
                "minItems": 19,
                "maxItems": 19,
                "items": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 90
                }
              }
            }
          },
          "noaa_cell_intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "noaa_cell_lon_lat": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          },
          "cloud_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "sun_elevation_deg": { "type": "number" }
        }
      },
      "Source": {
        "type": "object",
        "required": ["name", "attribution", "license", "url", "use"],
        "properties": {
          "name": { "type": "string" },
          "attribution": { "type": "string" },
          "license": { "type": "string" },
          "url": { "type": "string" },
          "use": { "type": "string" }
        }
      },
      "Meta": {
        "type": "object",
        "required": [
          "api_version",
          "generated_at",
          "as_of",
          "forecast_fetched_at",
          "data_version",
          "method_url",
          "sources"
        ],
        "properties": {
          "api_version": { "const": "v1" },
          "generated_at": { "type": "string", "format": "date-time" },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "description": "Top of the hour the answer is computed for."
          },
          "forecast_fetched_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Newest MET Norway fetch in the snapshot."
          },
          "data_version": { "type": "string" },
          "method_url": { "type": "string" },
          "sources": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Source" }
          },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error", "meta"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "enum": [
                  "invalid_parameter",
                  "unavailable",
                  "not_found",
                  "method_not_allowed"
                ]
              },
              "param": { "type": "string" },
              "message": { "type": "string" }
            }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "Verdict": {
        "type": "string",
        "enum": ["go", "marginal", "unknown", "no"],
        "description": "go: it fits. marginal: it fits with a catch the why names. unknown: the hourly forecast, about two and a half days ahead, does not reach that far yet. no: it does not fit."
      },
      "Sky": {
        "type": "object",
        "required": ["sunrise", "sunset", "moon_illumination"],
        "properties": {
          "sunrise": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Sunrise at the point; null in polar day or night."
          },
          "sunset": { "type": ["string", "null"], "format": "date-time" },
          "moon_illumination": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The moon's lit fraction at local midnight after the evening."
          }
        }
      },
      "SlotHour": {
        "type": "object",
        "description": "One hour of a slot with its weather; fields the forecast leaves out are omitted. The one bad hour a slot may hold has good false and fails. While the forecast data holds good hours only, a bad hour that failed the default test has no weather and no fails.",
        "required": ["time", "good"],
        "properties": {
          "time": { "type": "string", "format": "date-time" },
          "good": { "type": "boolean" },
          "fails": {
            "type": "array",
            "items": { "type": "string", "enum": ["rain", "wind", "cold"] },
            "description": "What the slot's one bad hour failed."
          },
          "rain_mm": { "type": "number" },
          "wind_kmh": { "type": "number" },
          "temp_c": { "type": "number" },
          "cloud_pct": { "type": "number" },
          "low_cloud_pct": { "type": "number" },
          "fog_pct": { "type": "number" }
        }
      },
      "Slot": {
        "type": "object",
        "description": "The day's best good-weather slot at the walk's start: daylight hours with at most 2 mm of rain and wind at most 80 km/h (or the caller's tighter limits), one bad hour tolerated.",
        "required": [
          "start",
          "end",
          "good_hours",
          "max_wind_kmh",
          "total_precip_mm",
          "max_rain_mm_h",
          "wet_hours",
          "min_temp_c",
          "max_temp_c"
        ],
        "properties": {
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" },
          "good_hours": { "type": "integer" },
          "max_wind_kmh": { "type": "number" },
          "total_precip_mm": { "type": "number" },
          "max_rain_mm_h": {
            "type": "number",
            "description": "The wettest good hour's rain, in mm."
          },
          "wet_hours": {
            "type": "integer",
            "description": "Good hours with at least 0.1 mm of rain."
          },
          "min_temp_c": { "type": "number" },
          "max_temp_c": { "type": "number" },
          "hours": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SlotHour" },
            "description": "The slot hour by hour, for the checked walk in a check; plan and the alternatives a check offers leave it out."
          }
        }
      },
      "Walk": {
        "type": "object",
        "description": "One Walkhighlands walk on one day.",
        "required": [
          "walk_id",
          "name",
          "url",
          "start_lat",
          "start_lon",
          "length_km",
          "ascent_m",
          "duration_h",
          "verdict",
          "why",
          "start_from",
          "start_by",
          "slot"
        ],
        "properties": {
          "walk_id": {
            "type": "string",
            "description": "Pass to check as walk_id."
          },
          "name": { "type": "string" },
          "url": {
            "type": "string",
            "description": "The walk's Walkhighlands page, which has the route."
          },
          "start_lat": { "type": "number" },
          "start_lon": { "type": "number" },
          "length_km": { "type": "number" },
          "ascent_m": { "type": "integer" },
          "duration_h": {
            "type": "number",
            "description": "Walkhighlands' estimated time."
          },
          "from_point_km": {
            "type": "number",
            "description": "From the asked point; absent for a walk checked by name."
          },
          "verdict": { "$ref": "#/components/schemas/Verdict" },
          "why": { "type": "string" },
          "start_from": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Earliest start that keeps the walk in the slot; null unless it fits."
          },
          "start_by": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Latest start that finishes inside the slot; null unless it fits."
          },
          "slot": {
            "oneOf": [
              { "$ref": "#/components/schemas/Slot" },
              { "type": "null" }
            ]
          }
        }
      },
      "Site": {
        "type": "object",
        "description": "One road-accessible dark-sky site on one night.",
        "required": [
          "site_id",
          "lat",
          "lon",
          "light_pollution_zone",
          "clear_sky_odds",
          "from_point_km",
          "verdict",
          "why",
          "clear_from",
          "clear_until",
          "clear_dark_hours",
          "moonless_clear_dark_hours"
        ],
        "properties": {
          "site_id": { "type": "string" },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "light_pollution_zone": {
            "type": "string",
            "description": "pristine, excellent or rural."
          },
          "clear_sky_odds": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "Share of dark hours that were clear here in this calendar month, historically."
          },
          "from_point_km": { "type": "number" },
          "verdict": { "$ref": "#/components/schemas/Verdict" },
          "why": { "type": "string" },
          "clear_from": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Start of the first clear dark hour, or of the first clear twilight hour when none is dark; null when none is clear."
          },
          "clear_until": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "End of the last clear dark hour, or clear twilight hour when none is dark. The hours between may have gaps."
          },
          "clear_dark_hours": { "type": "integer" },
          "moonless_clear_dark_hours": { "type": "integer" }
        }
      },
      "PlanDay": {
        "type": "object",
        "required": ["date", "sunrise", "sunset", "moon_illumination"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "sunrise": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Sunrise at the point; null in polar day or night."
          },
          "sunset": { "type": ["string", "null"], "format": "date-time" },
          "moon_illumination": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The moon's lit fraction at local midnight after the evening."
          },
          "walks": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Walk" },
            "description": "Walks that fit, go first. Today counts only hours not yet begun. Absent when none do."
          },
          "walk_note": {
            "type": "string",
            "description": "Why walks is empty."
          },
          "stargazing": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Site" },
            "description": "Sites for the night of this evening, go first, at least 5 km apart. Absent when none suit."
          },
          "stargazing_note": {
            "type": "string",
            "description": "Why stargazing is empty."
          }
        }
      },
      "PlanResult": {
        "type": "object",
        "required": ["query", "days"],
        "properties": {
          "query": {
            "type": "object",
            "description": "The inputs as used, after defaults and rounding.",
            "required": [
              "lat",
              "lon",
              "radius_km",
              "from",
              "to",
              "activities",
              "limit"
            ],
            "properties": {
              "lat": { "type": "number" },
              "lon": { "type": "number" },
              "radius_km": { "type": "number" },
              "from": { "type": "string", "format": "date" },
              "to": { "type": "string", "format": "date" },
              "activities": {
                "type": "array",
                "items": { "type": "string", "enum": ["walk", "stargaze"] }
              },
              "min_duration_h": { "type": "number" },
              "max_duration_h": { "type": "number" },
              "min_length_km": { "type": "number" },
              "max_length_km": { "type": "number" },
              "max_ascent_m": { "type": "integer" },
              "max_rain_mm_h": { "type": "number" },
              "max_wind_kmh": { "type": "number" },
              "min_temp_c": { "type": "number" },
              "limit": { "type": "integer" }
            }
          },
          "days": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PlanDay" }
          }
        }
      },
      "PlanResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/PlanResult" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "LightResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/LightResult" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "LightQuery": {
        "type": "object",
        "required": ["lat", "lon", "radius_km", "from", "to"],
        "properties": {
          "lat": { "type": "number", "minimum": 54.5, "maximum": 61 },
          "lon": { "type": "number", "minimum": -9, "maximum": -0.5 },
          "radius_km": { "type": "number", "minimum": 1, "maximum": 100 },
          "from": { "type": "string", "format": "date" },
          "to": { "type": "string", "format": "date" }
        }
      },
      "LightResult": {
        "type": "object",
        "required": ["query", "timezone", "site", "days", "nights"],
        "properties": {
          "query": { "$ref": "#/components/schemas/LightQuery" },
          "timezone": { "type": "string", "const": "Europe/London" },
          "site": { "$ref": "#/components/schemas/LightSite" },
          "days": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "items": { "$ref": "#/components/schemas/LightDay" }
          },
          "nights": {
            "type": "array",
            "description": "Distinct noon-to-noon NightDay labels represented in the windows. AssessNight suitability includes moonlight and coverage; it is never an interval cloud forecast. Lunar advice text is omitted because days already supply lunar geometry.",
            "items": { "$ref": "#/components/schemas/LightNight" }
          }
        }
      },
      "LightSite": {
        "type": ["object", "null"],
        "description": "Nearest snapshot site within min(radius_km,30) km. Null when absent; astronomy still answers.",
        "required": [
          "site_id",
          "lat",
          "lon",
          "distance_km",
          "forecast_fetched_at",
          "hourly_until",
          "truncated"
        ],
        "properties": {
          "site_id": { "type": "string" },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "distance_km": { "type": "number", "minimum": 0, "maximum": 30 },
          "forecast_fetched_at": { "$ref": "#/components/schemas/LightEvent" },
          "hourly_until": { "$ref": "#/components/schemas/LightEvent" },
          "truncated": {
            "type": "boolean",
            "description": "The materializer omitted some clear hours; missing rows cannot establish cloud."
          }
        }
      },
      "LightEvent": {
        "type": ["string", "null"],
        "format": "date-time",
        "description": "UTC RFC3339 instant, seconds. Null means no crossing on this civil date (including events on adjacent dates and persistent twilight), or absent source time where used in provenance. Numerical resolution is about a second, not a claim of astronomical accuracy."
      },
      "LightTwilight": {
        "type": "object",
        "required": ["dawn", "dusk"],
        "properties": {
          "dawn": { "$ref": "#/components/schemas/LightEvent" },
          "dusk": { "$ref": "#/components/schemas/LightEvent" }
        }
      },
      "LightMoon": {
        "type": "object",
        "required": [
          "rise",
          "set",
          "reference_at",
          "phase",
          "direction",
          "illumination"
        ],
        "properties": {
          "rise": { "$ref": "#/components/schemas/LightEvent" },
          "set": { "$ref": "#/components/schemas/LightEvent" },
          "reference_at": {
            "type": "string",
            "format": "date-time",
            "description": "Local noon of the civil date, expressed in UTC."
          },
          "phase": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Cycle fraction: new 0, first quarter .25, full .5, last quarter .75. Rounded to four decimal places."
          },
          "direction": {
            "type": "string",
            "enum": ["waxing", "waning"],
            "description": "Waxing before phase .5, waning from .5; derived from the unrounded signed illumination angle."
          },
          "illumination": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Lit disc fraction, at reference_at, rounded to four decimals."
          }
        }
      },
      "LightDay": {
        "type": "object",
        "required": [
          "date",
          "sunrise",
          "sunset",
          "civil",
          "nautical",
          "astronomical",
          "moon",
          "windows"
        ],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "sunrise": { "$ref": "#/components/schemas/LightEvent" },
          "sunset": { "$ref": "#/components/schemas/LightEvent" },
          "civil": { "$ref": "#/components/schemas/LightTwilight" },
          "nautical": { "$ref": "#/components/schemas/LightTwilight" },
          "astronomical": { "$ref": "#/components/schemas/LightTwilight" },
          "moon": { "$ref": "#/components/schemas/LightMoon" },
          "windows": {
            "type": "array",
            "description": "From-inclusive, until-exclusive intervals clipped to local midnight boundaries, sorted by from then kind. Absent windows are omitted, with an empty array when none exist. Sunrise/set and moonrise/set: centre -0.833 degrees. Twilight bands: civil -6 to -0.833, nautical -12 to -6, astronomical -18 to -12. Golden -4 to +6; blue -6 to -4. Milky Way: fixed core RA 17h45m, declination -29 degrees above 0, intersected with sun below -12. July twilight and moonlight can still limit visibility; no terrain/refraction model for core.",
            "items": { "$ref": "#/components/schemas/LightWindow" }
          }
        }
      },
      "LightWindow": {
        "type": "object",
        "required": ["kind", "from", "until", "night", "cloud"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "civil_twilight",
              "nautical_twilight",
              "astronomical_twilight",
              "golden",
              "blue",
              "astronomical_darkness",
              "milky_way"
            ]
          },
          "from": { "type": "string", "format": "date-time" },
          "until": { "type": "string", "format": "date-time" },
          "night": {
            "type": "string",
            "format": "date",
            "description": "Existing NightDay label at the window midpoint, named for its evening."
          },
          "cloud": { "$ref": "#/components/schemas/LightCloud" }
        }
      },
      "LightCloud": {
        "type": "object",
        "required": [
          "verdict",
          "coverage",
          "supported_seconds",
          "samples",
          "why"
        ],
        "description": "Scope is hourly clear twilight-dark sample support at result.site, attributed to MET Norway in meta.sources. A listed hour supports its hourly bucket, clipped further to requested-point sun below -10. This is neither a continuous cloud forecast nor night suitability. Expired, missing or future site fetches, hours before the as-of hour, hours after the earlier site/dataset 48-hour horizon and unsupported portions have no support. Absence never proves cloud.",
        "properties": {
          "verdict": {
            "type": "string",
            "enum": ["clear", "unknown"],
            "description": "Clear only when supported hourly bucket intersections cover the entire interval. Unknown when any portion lacks support. No cloudy verdict can be inferred from filtered rows."
          },
          "coverage": { "type": "string", "enum": ["full", "partial", "none"] },
          "supported_seconds": {
            "type": "integer",
            "minimum": 0,
            "description": "Union of supported bucket intersections, seconds; not a clear-sky probability."
          },
          "samples": { "type": "integer", "minimum": 0 },
          "why": { "type": "string" }
        }
      },
      "LightNight": {
        "type": "object",
        "required": ["night", "verdict", "coverage", "why"],
        "properties": {
          "night": { "type": "string", "format": "date" },
          "verdict": { "$ref": "#/components/schemas/Verdict" },
          "coverage": { "type": "string", "enum": ["full", "partial", "none"] },
          "why": { "type": "string" }
        }
      },
      "CheckItem": {
        "type": "object",
        "required": ["activity", "date"],
        "properties": {
          "activity": { "type": "string", "enum": ["walk", "stargaze"] },
          "date": {
            "type": "string",
            "format": "date",
            "description": "The day (YYYY-MM-DD, UK date), from today up to 13 days ahead; for stargazing, the evening the night starts, so before 09:00 the night under way is yesterday's date."
          },
          "walk_name": {
            "type": "string",
            "maxLength": 100,
            "description": "For a walk: words from its Walkhighlands name. Accents optional."
          },
          "walk_id": {
            "type": "string",
            "description": "For a walk: its walk_id from plan, instead of walk_name."
          },
          "lat": {
            "type": "number",
            "minimum": 54.5,
            "maximum": 61.0,
            "description": "For stargazing: latitude in decimal degrees."
          },
          "lon": {
            "type": "number",
            "minimum": -9.0,
            "maximum": -0.5,
            "description": "For stargazing: longitude in decimal degrees."
          }
        },
        "additionalProperties": false
      },
      "CheckRequest": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "$ref": "#/components/schemas/CheckItem" }
          },
          "max_rain_mm_h": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "description": "Walks: an hour counts as good only with at most this much rain, in mm. 0 means dry; the default 2 allows light rain; higher accepts wetter hours."
          },
          "max_wind_kmh": {
            "type": "number",
            "minimum": 0,
            "maximum": 120,
            "description": "Walks: an hour counts as good only with mean wind at most this, in km/h, at the walk's start. Default 80."
          },
          "min_temp_c": {
            "type": "number",
            "minimum": -30,
            "maximum": 30,
            "description": "Walks: an hour counts as good only at or above this temperature, in degrees C. Default none."
          }
        },
        "additionalProperties": false
      },
      "OtherDay": {
        "type": "object",
        "required": ["date", "verdict", "why"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "verdict": { "$ref": "#/components/schemas/Verdict" },
          "why": { "type": "string" }
        }
      },
      "CheckResultItem": {
        "type": "object",
        "required": ["activity", "date"],
        "properties": {
          "activity": { "type": "string", "enum": ["walk", "stargaze"] },
          "date": { "type": "string", "format": "date" },
          "verdict": { "$ref": "#/components/schemas/Verdict" },
          "why": { "type": "string" },
          "error": {
            "type": "string",
            "description": "Set, with the rest absent, when the item cannot be resolved: an unknown walk, or no dark-sky site within 30 km."
          },
          "walk": {
            "allOf": [
              { "$ref": "#/components/schemas/Walk" },
              {
                "type": "object",
                "properties": {
                  "also_matched": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Other walks walk_name matched, best first."
                  }
                }
              }
            ]
          },
          "night": {
            "allOf": [
              { "$ref": "#/components/schemas/Site" },
              {
                "type": "object",
                "properties": {
                  "site_note": {
                    "type": "string",
                    "description": "Set when no site was within 10 km of the point."
                  }
                }
              }
            ]
          },
          "sky": { "$ref": "#/components/schemas/Sky" },
          "other_days": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/OtherDay" },
            "description": "Other forecast days that suit it, go or marginal."
          },
          "nearby_walks": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Walk" },
            "description": "Up to two walks of similar length (half to one and a half times the time) starting within 20 km that fit better the same day, nearest first."
          },
          "nearby_nights": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Site" },
            "description": "Up to two better dark-sky sites within 30 km, the same night."
          }
        }
      },
      "CheckResult": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "limits": {
            "type": "object",
            "description": "The weather limits used, when any were given.",
            "required": [],
            "properties": {
              "max_rain_mm_h": { "type": "number" },
              "max_wind_kmh": { "type": "number" },
              "min_temp_c": { "type": "number" }
            }
          },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CheckResultItem" },
            "description": "One answer per item, in order."
          }
        }
      },
      "CheckResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/CheckResult" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      }
    }
  }
}
