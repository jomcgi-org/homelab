{
  "openapi": "3.1.0",
  "info": {
    "title": "Scotland outdoors API",
    "version": "v1",
    "summary": "Read-only answers to Scottish outdoor questions: where and when the sky will be dark and clear, and which walks fit the weather.",
    "description": "Narrow, question-shaped endpoints over forecast and climatology engines. Every response carries a provenance envelope (sources, attribution, forecast fetch time, method). Results and radius are capped; there is no bulk listing. Bulk extraction or redistribution of responses is not permitted.",
    "license": {
      "name": "Responses carry the source licences named in meta.sources"
    }
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/v1/dark-sky-windows": {
      "get": {
        "operationId": "dark_sky_windows",
        "summary": "Best dark-sky sites near a place for the next few nights",
        "description": "Ranks dark-sky sites within radius_km of a point by forecast clear-dark hours (cloud < 10%, sun below -12 degrees) over the next `nights` nights, then by clear-twilight hours (sun below -10 degrees, the midsummer fallback), then darker light-pollution zone, then distance. Each site carries a per-night breakdown and its historical clear-sky odds for the month. Give the coordinates of the place the caller means. Each site leads with best_night, its darkest clear night: clear-dark hours with the moon set count fully, moonlit ones by how little of the moon is lit.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": 54.5, "maximum": 61.0 },
            "description": "Latitude, decimal degrees. Rounded to 0.01."
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": -9.0, "maximum": -0.5 },
            "description": "Longitude, decimal degrees. Rounded to 0.01."
          },
          {
            "name": "radius_km",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 150,
              "default": 50
            }
          },
          {
            "name": "night",
            "in": "query",
            "schema": { "type": "string", "format": "date" },
            "description": "One night to ask about, named by its evening's date, within the next 7 nights. Use instead of nights."
          },
          {
            "name": "nights",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7,
              "default": 3
            },
            "description": "Nights to cover, starting tonight: the night in progress until 09:00 local, then the coming evening's. A night runs from local noon to local noon and is named by its evening's date."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 5
            }
          },
          {
            "name": "detail",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["summary", "hours"],
              "default": "summary"
            },
            "description": "summary (the default) leads with the best night or slot and leaves out hourly arrays; hours adds them."
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked sites.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DarkSkyWindowsResponse"
                }
              }
            }
          },
          "304": { "description": "Not modified (If-None-Match matched)." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/walk-windows": {
      "get": {
        "operationId": "walk_windows",
        "summary": "Walks near a place that fit the weather over the next few days",
        "description": "Ranks Walkhighlands walks whose start is within radius_km of a point, or whose name matches walk_name, by how many of the next `days` days hold a good-weather slot long enough for the walk's estimated time: daylight hours with at most 2 mm of rain and wind at most 80 km/h, one bad hour tolerated, and two hours of credit for walks over seven hours. Then by the earliest such day, then good hours, then distance. Weather is forecast at each walk's start. Each walk links to its Walkhighlands page, which has the route. Each walk leads with best, its earliest doable day and slot.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "schema": { "type": "number", "minimum": 54.5, "maximum": 61.0 },
            "description": "Latitude, decimal degrees. Rounded to 0.01. Required unless walk_name is given."
          },
          {
            "name": "lon",
            "in": "query",
            "schema": { "type": "number", "minimum": -9.0, "maximum": -0.5 },
            "description": "Longitude, decimal degrees. Rounded to 0.01. Required unless walk_name is given."
          },
          {
            "name": "walk_name",
            "in": "query",
            "schema": { "type": "string", "maxLength": 100 },
            "description": "Words from a Walkhighlands walk name, for example Ben Nevis; accents optional. Without lat and lon, searches every walk."
          },
          {
            "name": "radius_km",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            },
            "description": "Needs lat and lon."
          },
          {
            "name": "date",
            "in": "query",
            "schema": { "type": "string", "format": "date" },
            "description": "One UK day to ask about, up to 13 days ahead. Days past the hourly forecast come back with forecast_coverage none. Use instead of days."
          },
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 3
            },
            "description": "Days to cover, starting today (UK time). The hourly forecast reaches about two and a half days."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 5
            }
          },
          {
            "name": "max_duration_h",
            "in": "query",
            "schema": { "type": "number", "minimum": 0.5, "maximum": 24 },
            "description": "Only walks whose estimated time is at most this many hours."
          },
          {
            "name": "max_ascent_m",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 3000 },
            "description": "Only walks with at most this much ascent, in metres."
          },
          {
            "name": "detail",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["summary", "hours"],
              "default": "summary"
            },
            "description": "summary (the default) leads with the best night or slot and leaves out hourly arrays; hours adds them."
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked walks.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WalkWindowsResponse" }
              }
            }
          },
          "304": { "description": "Not modified (If-None-Match matched)." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/method": {
      "get": {
        "operationId": "method",
        "summary": "How the answers are computed",
        "responses": {
          "200": {
            "description": "Method description.",
            "content": { "text/markdown": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "openapi",
        "summary": "This document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document.",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Invalid parameter.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unavailable": {
        "description": "Forecast data not loaded yet.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "Source": {
        "type": "object",
        "required": ["name", "attribution", "license", "url", "use"],
        "properties": {
          "name": { "type": "string" },
          "attribution": { "type": "string" },
          "license": { "type": "string" },
          "url": { "type": "string" },
          "use": { "type": "string" }
        }
      },
      "Meta": {
        "type": "object",
        "required": [
          "api_version",
          "generated_at",
          "as_of",
          "forecast_fetched_at",
          "data_version",
          "method_url",
          "sources"
        ],
        "properties": {
          "api_version": { "const": "v1" },
          "generated_at": { "type": "string", "format": "date-time" },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "description": "Top of the hour the answer is computed for."
          },
          "forecast_fetched_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Newest MET Norway fetch in the snapshot."
          },
          "data_version": { "type": "string" },
          "method_url": { "type": "string" },
          "sources": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Source" }
          },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error", "meta"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "enum": [
                  "invalid_parameter",
                  "unavailable",
                  "not_found",
                  "method_not_allowed"
                ]
              },
              "param": { "type": "string" },
              "message": { "type": "string" }
            }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "Hour": {
        "type": "object",
        "required": [
          "time",
          "cloud_area_fraction",
          "dark",
          "moon_altitude_deg"
        ],
        "properties": {
          "time": { "type": "string", "format": "date-time" },
          "cloud_area_fraction": {
            "type": "number",
            "description": "Forecast cloud cover, percent."
          },
          "dark": {
            "type": "boolean",
            "description": "Sun below -12 degrees; false means twilight (-12 to -10)."
          },
          "moon_altitude_deg": {
            "type": "number",
            "description": "The moon's altitude at the site; below zero it is set."
          }
        }
      },
      "Night": {
        "type": "object",
        "required": [
          "night",
          "clear_dark_hours",
          "clear_twilight_hours",
          "moonless_clear_dark_hours",
          "moon_illumination",
          "clear_from",
          "clear_until"
        ],
        "properties": {
          "night": { "type": "string", "format": "date" },
          "clear_dark_hours": { "type": "integer" },
          "clear_twilight_hours": { "type": "integer" },
          "moonless_clear_dark_hours": {
            "type": "integer",
            "description": "Clear-dark hours with the moon below the horizon or under 10% lit."
          },
          "moon_illumination": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Lit fraction of the moon at local midnight."
          },
          "clear_from": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Start of the first clear hour."
          },
          "clear_until": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "End of the last clear hour; the hours between may have gaps."
          },
          "hours": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Hour" },
            "description": "Only with detail=hours, and only in nights (never in best_night)."
          }
        }
      },
      "Site": {
        "type": "object",
        "required": [
          "site_id",
          "lat",
          "lon",
          "distance_km",
          "altitude_m",
          "light_pollution_zone",
          "clear_dark_hours",
          "clear_twilight_hours",
          "moonless_clear_dark_hours",
          "forecast_hours_truncated",
          "best_night",
          "nights",
          "climatology"
        ],
        "properties": {
          "site_id": { "type": "string" },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "distance_km": { "type": "number" },
          "altitude_m": { "type": "integer" },
          "light_pollution_zone": { "type": "string" },
          "clear_dark_hours": { "type": "integer" },
          "clear_twilight_hours": { "type": "integer" },
          "moonless_clear_dark_hours": { "type": "integer" },
          "forecast_hours_truncated": { "type": "boolean" },
          "best_night": {
            "oneOf": [
              { "$ref": "#/components/schemas/Night" },
              { "type": "null" }
            ],
            "description": "The night with the most moon-weighted clear-dark hours, then clear-twilight; null if none is clear. Never carries hours."
          },
          "nights": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Night" }
          },
          "climatology": {
            "type": ["object", "null"],
            "required": [
              "month",
              "clear_dark_hours",
              "dark_hours",
              "clear_sky_odds"
            ],
            "properties": {
              "month": { "type": "integer", "minimum": 1, "maximum": 12 },
              "clear_dark_hours": { "type": "integer" },
              "dark_hours": { "type": "integer" },
              "clear_sky_odds": {
                "type": ["number", "null"],
                "description": "Historical share of dark hours that were clear, this month."
              }
            }
          }
        }
      },
      "DarkSkyWindowsResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["query", "darkness_mode", "nights", "sites"],
            "properties": {
              "query": {
                "type": "object",
                "required": [
                  "lat",
                  "lon",
                  "radius_km",
                  "nights",
                  "limit",
                  "detail"
                ],
                "properties": {
                  "lat": { "type": "number" },
                  "lon": { "type": "number" },
                  "radius_km": { "type": "number" },
                  "nights": { "type": "integer" },
                  "limit": { "type": "integer" },
                  "night": { "type": "string", "format": "date" },
                  "detail": { "enum": ["summary", "hours"] }
                }
              },
              "darkness_mode": { "enum": ["astronomical", "twilight", "none"] },
              "nights": {
                "type": "array",
                "items": { "type": "string", "format": "date" }
              },
              "sites": {
                "type": "array",
                "maxItems": 10,
                "items": { "$ref": "#/components/schemas/Site" }
              }
            }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "WalkHour": {
        "type": "object",
        "required": ["time", "temp_c", "precip_mm", "wind_kmh", "cloud_pct"],
        "properties": {
          "time": { "type": "string", "format": "date-time" },
          "temp_c": { "type": "number" },
          "precip_mm": { "type": "number" },
          "wind_kmh": { "type": "number" },
          "cloud_pct": { "type": "number" }
        }
      },
      "WalkDay": {
        "type": "object",
        "required": [
          "date",
          "forecast_coverage",
          "doable",
          "good_hours",
          "best_slot"
        ],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "forecast_coverage": {
            "enum": ["full", "partial", "none"],
            "description": "How much of the day's daylight the hourly forecast covers."
          },
          "doable": {
            "type": ["boolean", "null"],
            "description": "Null when the forecast does not reach far enough to decide."
          },
          "good_hours": { "type": "integer" },
          "best_slot": {
            "oneOf": [
              { "$ref": "#/components/schemas/WalkSlot" },
              { "type": "null" }
            ]
          },
          "hours": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WalkHour" },
            "description": "Only with detail=hours."
          }
        }
      },
      "Walk": {
        "type": "object",
        "required": [
          "walk_id",
          "name",
          "url",
          "start_lat",
          "start_lon",
          "length_km",
          "ascent_m",
          "duration_h",
          "doable_days",
          "best",
          "days"
        ],
        "properties": {
          "walk_id": { "type": "string" },
          "name": { "type": "string" },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The walk's Walkhighlands page, with the route."
          },
          "start_lat": { "type": "number" },
          "start_lon": { "type": "number" },
          "from_point_km": {
            "type": "number",
            "description": "Only when lat and lon were given."
          },
          "length_km": { "type": "number" },
          "ascent_m": { "type": "integer" },
          "duration_h": { "type": "number" },
          "doable_days": { "type": "integer" },
          "best": {
            "oneOf": [
              {
                "allOf": [
                  { "$ref": "#/components/schemas/WalkSlot" },
                  {
                    "type": "object",
                    "required": ["date"],
                    "properties": {
                      "date": { "type": "string", "format": "date" }
                    }
                  }
                ]
              },
              { "type": "null" }
            ],
            "description": "The earliest doable day and its slot; null if none."
          },
          "days": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WalkDay" }
          }
        }
      },
      "WalkWindowsResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["query", "days", "walks"],
            "properties": {
              "query": {
                "type": "object",
                "required": ["days", "limit", "detail"],
                "properties": {
                  "lat": { "type": "number" },
                  "lon": { "type": "number" },
                  "walk_name": { "type": "string" },
                  "radius_km": { "type": "number" },
                  "date": { "type": "string", "format": "date" },
                  "days": { "type": "integer" },
                  "limit": { "type": "integer" },
                  "max_duration_h": { "type": "number" },
                  "max_ascent_m": { "type": "integer" },
                  "detail": { "enum": ["summary", "hours"] }
                }
              },
              "days": {
                "type": "array",
                "items": { "type": "string", "format": "date" }
              },
              "walks": {
                "type": "array",
                "maxItems": 10,
                "items": { "$ref": "#/components/schemas/Walk" }
              }
            }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "WalkSlot": {
        "type": "object",
        "required": [
          "start",
          "end",
          "good_hours",
          "max_wind_kmh",
          "total_precip_mm",
          "min_temp_c",
          "max_temp_c"
        ],
        "properties": {
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" },
          "good_hours": { "type": "integer" },
          "max_wind_kmh": { "type": "number" },
          "total_precip_mm": { "type": "number" },
          "min_temp_c": { "type": "number" },
          "max_temp_c": { "type": "number" }
        }
      }
    }
  }
}
