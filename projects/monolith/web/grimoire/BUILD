# The friends Grimoire UI: a client-only React app on Astryx (see AGENTS.md).
# Hand-written like //projects/monolith/frontend: pnpm/rules_js packages are not
# generated by gazelle. `ignore` covers this directory only, so the source
# subtrees are excluded here too: otherwise gazelle descends into them and
# generates ts_project targets that have no tsconfig and fail at load time.
# gazelle:ignore
# gazelle:exclude src
# gazelle:exclude preview
# gazelle:exclude public
load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//projects/monolith/web/grimoire:typescript/package_json.bzl", typescript_bin = "bin")
load("@npm//projects/monolith/web/grimoire:vite/package_json.bzl", vite_bin = "bin")
load("@npm//projects/monolith/web/grimoire:vitest/package_json.bzl", vitest_bin = "bin")

npm_link_all_packages(name = "node_modules")

_RUNTIME_DEPS = [
    ":node_modules/@astryxdesign/core",
    ":node_modules/@astryxdesign/theme-neutral",
    ":node_modules/@stylexjs/stylex",
    ":node_modules/@tanstack/react-query",
    ":node_modules/react",
    ":node_modules/react-dom",
    ":node_modules/react-router",
]

_BUILD_DEPS = [
    ":node_modules/@esbuild/linux-x64",
    ":node_modules/@rollup/rollup-linux-x64-gnu",
    ":node_modules/vite",
]

js_library(
    name = "src",
    srcs = glob(
        [
            "public/**/*",
            "src/**/*",
        ],
        exclude = [
            "src/**/*.test.js",
            "src/**/*.test.ts",
            "src/**/*.test.tsx",
        ],
    ) + [
        "index.html",
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
    ],
    deps = _RUNTIME_DEPS + _BUILD_DEPS,
)

vite_bin.vite_binary(name = "vite")

# The production bundle, shipped in the backend image and served under
# GRIMOIRE_BASE (see vite.config.ts and grimoire/web.py).
js_run_binary(
    name = "build",
    srcs = [":src"],
    args = ["build"],
    chdir = package_name(),
    out_dirs = ["dist"],
    tool = ":vite",
    visibility = ["//projects/monolith:__pkg__"],
)

build_test(
    name = "build_test",
    targets = [":build"],
)

js_library(
    name = "preview_src",
    srcs = [
        "preview/index.html",
        "preview/main.tsx",
        "vite.preview.config.ts",
    ],
    deps = [":src"],
)

# The fixture preview: every screen against the in-memory backend in
# src/test/world.ts, with no network and no sign-in.
js_run_binary(
    name = "fixture_preview",
    srcs = [":preview_src"],
    args = [
        "build",
        "--config",
        "vite.preview.config.ts",
    ],
    chdir = package_name(),
    out_dirs = ["dist-preview"],
    tool = ":vite",
)

build_test(
    name = "fixture_preview_build_test",
    targets = [":fixture_preview"],
)

js_library(
    name = "test_src",
    srcs = glob([
        "src/**/*.test.js",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
    ]) + ["vitest.config.ts"],
    deps = [
        ":node_modules/@testing-library/dom",
        ":node_modules/@testing-library/react",
        ":node_modules/@testing-library/user-event",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/happy-dom",
        ":node_modules/vitest",
        ":preview_src",
    ],
)

# Unit and screen tests, plus the house rules in src/rules.test.ts.
vitest_bin.vitest_test(
    name = "test",
    args = ["run"],
    chdir = package_name(),
    data = [":test_src"],
)

# The API contract (src/api/schema.ts) is generated from the backend's response
# models, so a breaking backend change fails here.
typescript_bin.tsc_test(
    name = "typecheck",
    args = ["--noEmit"],
    chdir = package_name(),
    data = [":test_src"],
)

# Golden reveal projections and the DM-only route list: read by this app's
# vitest (via :src) and by //projects/monolith:grimoire_visibility_test, so a
# server change and a renderer change each fail the side that owns it.
filegroup(
    name = "reveal_projection_fixture",
    srcs = [
        "src/lib/fixtures/dm-only-routes.json",
        "src/lib/fixtures/reveal-projections.json",
    ],
    visibility = ["//projects/monolith:__pkg__"],
)

# The anonymous invitation landing's browser script. grimoire/join_landing.py
# embeds it in the page it serves; its DOM tests run in :test.
filegroup(
    name = "join_landing_script",
    srcs = ["src/lib/join-landing.js"],
    visibility = ["//projects/monolith:__pkg__"],
)

# Compared byte for byte with the generator's output by
# //projects/monolith:grimoire_browser_api_schema_test.
filegroup(
    name = "api_schema",
    srcs = ["src/api/schema.ts"],
    visibility = ["//projects/monolith:__pkg__"],
)

# Markdown read by the monolith doc-manifest genrules (#6446). See
# //projects/monolith:repo_docs_srcs.
filegroup(
    name = "repo_docs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//projects/monolith:__pkg__"],
)
