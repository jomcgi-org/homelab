      "name": "No destroy before confirm",
      "meaning": "A VM is recorded destroyed only after the node confirms it."
    },
    {
      "key": "eventually_dispatched",
      "name": "Eventually dispatched",
      "meaning": "A queued task gets a VM within two checkpoints."
    },
    {
      "key": "inventory_reconciled",
      "name": "Inventory reconciled",
      "meaning": "The VMs the node reports live are the VMs the control plane knows about."
