vitest_bin.vitest_test(
    name = "test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "BUILD",
        # Compile Svelte templates whenever the frontend test target runs.
        ":build",
        ":src",
        ":test_lib",
    ],
)

