npm_link_all_packages(name = "node_modules")

vite_bin.vite_binary(name = "vite")

# The frontend package now owns a fixture-harness README. Keep it in the
# same indexed documentation closure as every other repository package.
filegroup(
    name = "repo_docs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//projects/monolith:__pkg__"],
)

# The public /docs manifest is a build output, not a committed file (#6446).
# The generator selects its exact allowlisted project docs from the same
# aggregate the repo-docs manifest reads; an edit to any other doc reruns this
# cheap action but leaves its output, and so the vite build, cached.
genrule(
    name = "docs_manifest",
    srcs = ["//projects/monolith:repo_docs_srcs"],
    outs = ["src/lib/public/docs/docs-manifest.json"],
    cmd = "python3 $(execpath //projects/monolith:knowledge/tools/gen_docs_manifest.py) --out $@ $(SRCS)",
    tools = [
        "//projects/monolith:knowledge/tools/gen_docs_manifest.py",
        "//projects/monolith:knowledge/tools/prettier_json.py",
        "//projects/monolith:knowledge/tools/public_content.py",
    ],
    visibility = ["//projects/monolith:__pkg__"],
)

js_library(
    name = "src",
    srcs = glob(
        [
            "src/**/*",
            "static/**/*",
        ],
        allow_empty = True,
        exclude = [
            "src/**/*.test.js",
            # Generated by :docs_manifest above; a local copy written for
            # `pnpm dev` is gitignored and must not shadow the build output.
            "src/lib/public/docs/docs-manifest.json",
        ],
    ) + [
        "package.json",
        "svelte.config.js",
        "vite.config.js",
        ":docs_manifest",
    ],
    deps = [
        ":node_modules/@homelab/design-system",
        ":node_modules/@sveltejs/adapter-node",
        ":node_modules/@sveltejs/kit",
        ":node_modules/@sveltejs/vite-plugin-svelte",
        ":node_modules/mdsvex",
        ":node_modules/svelte",
        ":node_modules/vite",
        # Hand-drawn SVG rendering
        ":node_modules/roughjs",
        # DAG layout engine
        ":node_modules/@dagrejs/dagre",
        # Runtime markdown rendering
        ":node_modules/marked",
        # Client-side mermaid diagram rendering on the public docs pages
        ":node_modules/mermaid",
        # WebGL basemap for the /app/ships live vessel map
        ":node_modules/maplibre-gl",
        # OpenTelemetry browser tracing
        ":node_modules/@opentelemetry/api",
        ":node_modules/@opentelemetry/sdk-trace-web",
        ":node_modules/@opentelemetry/exporter-trace-otlp-http",
        ":node_modules/@opentelemetry/instrumentation",
        ":node_modules/@opentelemetry/instrumentation-document-load",
        ":node_modules/@opentelemetry/instrumentation-fetch",
        ":node_modules/@opentelemetry/resources",
        ":node_modules/@opentelemetry/semantic-conventions",
        # Platform-specific native binaries for Linux CI (loaded at runtime via require())
        ":node_modules/@rollup/rollup-linux-x64-gnu",
        ":node_modules/@esbuild/linux-x64",
        # d3 sub-packages used by the /notes graph view
        ":node_modules/d3-quadtree",
        ":node_modules/d3-selection",
        ":node_modules/d3-zoom",
        # Terminal emulator for the private k8s demo tab (client-only dynamic
        # import; the package must still be linked for vite to resolve it)
        ":node_modules/@xterm/xterm",
        ":node_modules/@xterm/addon-fit",
    ],
)

js_run_binary(
    name = "build",
    srcs = [":src"],
    args = ["build"],
    chdir = package_name(),
    # Out dir is "dist", not "build": svelte.config.js defaults there so a
    # local vite build cannot collide with this BUILD file on macOS's
    # case-insensitive filesystem. build_tar remaps it to /app/build.
    out_dirs = ["dist"],
    tool = ":vite",
    visibility = ["//projects/monolith:__pkg__"],
)

# Public-only source tree (ADR 004 Phase 5d code-absence): identical to :src but
# additionally excludes both authenticated route trees and private-only
# components. SvelteKit is filesystem-routed, so omitting these files from the
# source set drops those pages, their SSR handlers, and their client chunks
# entirely from the public build. Friends routes have their own authorization
# lane, so their source must be absent from the anonymous artifact too.
js_library(
    name = "src_public",
    srcs = glob(
        [
            "src/**/*",
            "static/**/*",
        ],
        allow_empty = True,
        exclude = [
            "src/**/*.test.js",
            "src/routes/private/**",
            "src/routes/friends/**",
            "src/lib/private/**",
            "src/lib/public/docs/docs-manifest.json",
        ],
    ) + [
        "package.json",
        "svelte.config.js",
        "vite.config.js",
        ":docs_manifest",
    ],
    deps = [
        ":node_modules/@homelab/design-system",
        ":node_modules/@sveltejs/adapter-node",
        ":node_modules/@sveltejs/kit",
        ":node_modules/@sveltejs/vite-plugin-svelte",
        ":node_modules/mdsvex",
        ":node_modules/svelte",
        ":node_modules/vite",
        # Hand-drawn SVG rendering
        ":node_modules/roughjs",
        # DAG layout engine
        ":node_modules/@dagrejs/dagre",
        # Runtime markdown rendering
        ":node_modules/marked",
        # Client-side mermaid diagram rendering on the public docs pages
        ":node_modules/mermaid",
        # WebGL basemap for the /app/ships live vessel map
        ":node_modules/maplibre-gl",
        # OpenTelemetry browser tracing
        ":node_modules/@opentelemetry/api",
        ":node_modules/@opentelemetry/sdk-trace-web",
        ":node_modules/@opentelemetry/exporter-trace-otlp-http",
        ":node_modules/@opentelemetry/instrumentation",
        ":node_modules/@opentelemetry/instrumentation-document-load",
        ":node_modules/@opentelemetry/instrumentation-fetch",
        ":node_modules/@opentelemetry/resources",
        ":node_modules/@opentelemetry/semantic-conventions",
        # Platform-specific native binaries for Linux CI (loaded at runtime via require())
        ":node_modules/@rollup/rollup-linux-x64-gnu",
        ":node_modules/@esbuild/linux-x64",
        # d3 sub-packages used by the /notes graph view
        ":node_modules/d3-quadtree",
        ":node_modules/d3-selection",
        ":node_modules/d3-zoom",
    ],
)

js_run_binary(
    name = "build_public",
    srcs = [":src_public"],
    args = ["build"],
    chdir = package_name(),
    env = {"SVELTE_OUT_DIR": "build_public"},
    # Distinct out dir (svelte.config reads SVELTE_OUT_DIR) so this action does
    # not collide with :build's "build" output in the same package.
    # build_tar_public remaps it to /app/build at image time, so the runtime
    # path is unchanged.
    out_dirs = ["build_public"],
    tool = ":vite",
    visibility = ["//projects/monolith:__pkg__"],
)

# Validate the frontend builds in CI without going through py3_image's
# platform transition (which breaks native npm packages like esbuild/rollup).
build_test(
    name = "build_test",
    targets = [":build"],
)

build_test(
    name = "build_test_public",
    targets = [":build_public"],
)

genrule(
    name = "build_tar",
    srcs = [":build"],
    outs = ["build_tar.tar"],
    cmd = """
        set -euo pipefail
        mkdir -p tmp/app/build
        cp -rL $(location :build)/* tmp/app/build/
        chown -R 65532:65532 tmp/app 2>/dev/null || true
        tar -C tmp --owner=65532 --group=65532 -cf $@ .
    """,
)

genrule(
    name = "build_tar_public",
    srcs = [":build_public"],
    outs = ["build_tar_public.tar"],
    cmd = """
        set -euo pipefail
        mkdir -p tmp/app/build
        cp -rL $(location :build_public)/* tmp/app/build/
        chown -R 65532:65532 tmp/app 2>/dev/null || true
        tar -C tmp --owner=65532 --group=65532 -cf $@ .
    """,
)

