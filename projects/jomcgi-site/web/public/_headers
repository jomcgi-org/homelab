# Response headers for every file this Worker serves (Workers static assets).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://data.jomcgi.dev; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite names these files by content hash, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Section data files are named by content hash (data/snapshot.mjs), so they
# never change. Each section's latest.json keeps the default revalidation.
/data/:section/v/*
  Cache-Control: public, max-age=31536000, immutable

# The preview host stays out of search results. Crawlers may fetch it (robots.txt
# allows them), so they see this header; a robots.txt Disallow would hide it.
https://next.jomcgi.dev/*
  X-Robots-Tag: noindex

# The drafts note stays unindexed on every host.
/slop
  X-Robots-Tag: noindex, nofollow

# Same anonymous catalog policy as the hub; browsers revalidate.
/scotland/marketplace.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400, stale-if-error=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=3600, stale-while-revalidate=86400, stale-if-error=31536000
