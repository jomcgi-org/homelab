# Response headers for every file this Worker serves (Workers static assets).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://data.jomcgi.dev; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Only the hikes map needs the tile host, MapLibre's blob worker and the
# reader's location. Detach the site policy, then set the wider one.
/hikes
  ! Content-Security-Policy
  ! Permissions-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://tiles.openfreemap.org; font-src 'self'; connect-src 'self' https://data.jomcgi.dev https://tiles.openfreemap.org; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)

# The /app/hikes 301 (HOME-178 URL contract) must not stay in a browser's
# cache: after a rollback the hub serves /app/hikes again.
/app/hikes
  Cache-Control: public, max-age=0, must-revalidate

/app/hikes/*
  Cache-Control: public, max-age=0, must-revalidate

# Only the stars page loads the base map and its blob worker (HOME-210).
/stars
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://tiles.openfreemap.org; font-src 'self'; connect-src 'self' https://data.jomcgi.dev https://tiles.openfreemap.org; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'

# The /app/stars 301 must not stay in a browser's cache either (HOME-210).
/app/stars
  Cache-Control: public, max-age=0, must-revalidate

/app/stars/*
  Cache-Control: public, max-age=0, must-revalidate

# Vite names these files by content hash, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The dedicated MapLibre worker fetches vector tiles under its own CSP.
/assets/maplibre-gl-worker-*.js
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://data.jomcgi.dev https://tiles.openfreemap.org; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'

# Section data files are named by content hash (data/snapshot.mjs), so they
# never change. Each section's latest.json keeps the default revalidation.
/data/:section/v/*
  Cache-Control: public, max-age=31536000, immutable

# The preview host stays out of search results. Crawlers may fetch it (robots.txt
# allows them), so they see this header; a robots.txt Disallow would hide it.
https://next.jomcgi.dev/*
  X-Robots-Tag: noindex

# The drafts note stays unindexed on every host.
/slop
  X-Robots-Tag: noindex, nofollow

# Same anonymous catalog policy as the hub; browsers revalidate.
/scotland/marketplace.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400, stale-if-error=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=3600, stale-while-revalidate=86400, stale-if-error=31536000
