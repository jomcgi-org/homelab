{
  "zone": "jomcgi.dev",
  "rules": [
    {
      "description": "Monolith",
      "expression": "(http.host eq \"jomcgi.dev\") or (http.host eq \"private.jomcgi.dev\")",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "bypass_by_default"
        },
        "serve_stale": {
          "disable_stale_while_updating": false
        }
      },
      "enabled": true
    },
    {
      "description": "Factory data",
      "expression": "(http.host eq \"factory-data.jomcgi.dev\")",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "respect_origin"
        },
        "browser_ttl": {
          "mode": "respect_origin"
        }
      },
      "enabled": true
    }
  ]
}
