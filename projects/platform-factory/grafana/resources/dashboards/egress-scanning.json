          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(factory_egress_scan_check_duration_seconds_bucket{job=\"egress-scan\",outcome=~\"allowed|credential_blocked|engine_unavailable\"}[$__rate_interval])))",
