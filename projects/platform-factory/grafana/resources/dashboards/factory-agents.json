    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU by pool",
      "description": "Cores used, summed per namespace.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace) (rate(pod_cpu_usage_seconds_total{namespace=~\"$pool\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{namespace}}"
        }
