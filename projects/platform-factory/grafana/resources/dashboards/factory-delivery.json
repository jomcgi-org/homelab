          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (grant) (factory_broker_codex_grant_expires_at_seconds) - time()",
          "refId": "A",
          "legendFormat": "{{grant}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 600
              },
              {
                "color": "green",
                "value": 3600
              }
