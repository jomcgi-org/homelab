{
  "uid": "factory-delivery",
  "title": "Factory delivery",
  "description": "The credential broker (factory_broker_*) and the connector (factory_connector_*): the Codex grant, model relay, itsaplan runs and their delivery as pull requests. Counters appear once first incremented. projects/factory/ARCHITECTURE.md describes each step.",
  "tags": ["factory"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
