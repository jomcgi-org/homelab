        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (cluster, pod, node) (cnpg_pg_replication_in_recovery{cluster=~\"$cluster\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "primary",
                  "color": "green"
                },
                "1": {
                  "text": "replica",
                  "color": "blue"
                }
