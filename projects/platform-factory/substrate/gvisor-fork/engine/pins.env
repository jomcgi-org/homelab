# Every pin of the engine image build, read by build.sh, make-layer.py and the
# "Substrate fork engine image" workflow. Change a value here, nowhere else.

# Semgrep OSS engine (LGPL-2.1-or-later): the PyPI wheel for linux x86_64. It
# holds semgrep-core and its libraries. No Pro engine, no token, no rules.
SEMGREP_VERSION=1.186.0
WHEEL_FILE=semgrep-1.186.0-cp310.cp311.cp312.cp313.cp314.py310.py311.py312.py313.py314-none-manylinux_2_34_x86_64.whl
WHEEL_URL=https://files.pythonhosted.org/packages/fd/8c/25b9b38199d0bb5ec2fb12dbea2a7172b6cd0672a1161e2e33dbf3029cd1/semgrep-1.186.0-cp310.cp311.cp312.cp313.cp314.py310.py311.py312.py313.py314-none-manylinux_2_34_x86_64.whl
WHEEL_SHA256=54ebaf79adf4e5855c54d5e4457d8d03f27cc6bf73d79642281790b833d92e4f

# Runtime base: distroless Debian 12 (glibc 2.36, user 65532), linux/amd64
# manifest of the "nonroot" tag. The wheel needs glibc 2.34 or newer.
BASE_IMAGE=gcr.io/distroless/base-debian12@sha256:5883c320d81f76c764e114c9ab14054f037bb040907816fc9028d80d9602a7c3

# Compiler for the shim and the launcher: the same Debian 12, so the binaries
# link against the glibc of the base image (a newer runner glibc would not run).
BUILDER_IMAGE=gcc:12.4.0-bookworm@sha256:c56a5103128101e0b3a84af0ee6dfa6f8ef0915d92f676d10800d2a083929cbd

# crane appends the layer to the base and pushes. The release tarball, checked
# against the checksums.txt of the release.
CRANE_VERSION=v0.20.6
CRANE_URL=https://github.com/google/go-containerregistry/releases/download/v0.20.6/go-containerregistry_Linux_x86_64.tar.gz
CRANE_SHA256=c1d593d01551f2c9a3df5ca0a0be4385a839bd9b86d4a76e18d7b17d16559127
