# Pins of the Pro engine image that only this directory owns. Every other pin
# (Semgrep version, wheel, base image, builder image, crane) comes from
# ../engine/pins.env, so the Pro binary and the libraries of the wheel always
# have the same Semgrep version. Change a value in one place only.

# Where the Pro engine and the Secrets rules come from, and for which platform.
# These are the calls of `semgrep install-semgrep-pro` and of `semgrep ci` for
# the platform manylinux-x86 (glibc, x86_64).
SEMGREP_URL=https://semgrep.dev
PRO_PLATFORM=manylinux-x86

# sha256 of the Pro binary that was tested. Empty until the first build: copy the
# value from the job summary after Joe has seen one good run, and a later run
# then fails when Semgrep serves a different binary for the same version.
PRO_BINARY_SHA256=

# Sanity limits for the download, not a check of the content. 1586 Secrets
# rules and a 339 MB binary were measured on 2026-11-22. A smaller binary or a
# small rule set means a failed or partial download.
PRO_BINARY_MIN_BYTES=100000000
RULES_MIN_COUNT=1000

# The only token that goes into the image. Not a secret: the Pro engine checks
# that a token is present at start and does not use it after that. The launcher
# reads it from /semgrep/.tok and exports it as SEMGREP_APP_TOKEN. The workflow
# fails the build if it is missing from the image or is anywhere else in it.
PLACEHOLDER_TOKEN=placeholder-not-a-semgrep-token-engine-image-build-only
