+
+func TestFactorySecretCacheScope(t *testing.T) {
+	options := buildManagerOptions(managerConfig{}).Cache
+	if len(options.DefaultNamespaces) != 0 {
+		t.Fatal("Gateway and route informers require all namespaces")
+	}
+	if len(options.ByObject) != 1 {
+		t.Fatalf("expected one type-specific cache, got %d", len(options.ByObject))
+	}
+	for obj, config := range options.ByObject {
+		if _, ok := obj.(*corev1.Secret); !ok {
+			t.Fatalf("expected Secret cache, got %T", obj)
+		}
+		if _, ok := config.Namespaces["cfgate-system"]; !ok || len(config.Namespaces) != 1 {
+			t.Fatalf("expected Secret cache only in cfgate-system, got %v", config.Namespaces)
+		}
+	}
+}
