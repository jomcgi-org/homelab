SET LOCAL ROLE kagent_owner;
CREATE SCHEMA IF NOT EXISTS kagent AUTHORIZATION kagent_owner;
REVOKE ALL ON SCHEMA kagent FROM PUBLIC;
GRANT USAGE ON SCHEMA kagent TO kagent_readwrite;
ALTER DEFAULT PRIVILEGES IN SCHEMA kagent GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO kagent_readwrite;
ALTER DEFAULT PRIVILEGES IN SCHEMA kagent GRANT USAGE, SELECT, UPDATE ON SEQUENCES TO kagent_readwrite;
ALTER DEFAULT PRIVILEGES IN SCHEMA kagent GRANT EXECUTE ON ROUTINES TO kagent_readwrite;
ALTER DEFAULT PRIVILEGES IN SCHEMA kagent GRANT USAGE ON TYPES TO kagent_readwrite;

-- CNPG's metrics collector uses pg_monitor. Expose only the claim pairs,
-- including on a fresh install where kagent has not migrated its tables yet.
CREATE OR REPLACE FUNCTION kagent.pending_claims()
RETURNS TABLE(session_id text, executor_id text)
LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = pg_catalog AS $$
BEGIN
  IF to_regclass('kagent.session') IS NULL OR to_regclass('kagent.session_task_event') IS NULL THEN
    RETURN;
  END IF;
  RETURN QUERY SELECT DISTINCT s.id::text, e.quiescence_executor_id::text
    FROM kagent.session s JOIN kagent.session_task_event e USING (history_id)
    WHERE e.quiescence_pending AND e.quiescence_executor_id IS NOT NULL;
END
$$;
REVOKE ALL ON FUNCTION kagent.pending_claims() FROM PUBLIC, kagent_readwrite;
GRANT USAGE ON SCHEMA kagent TO pg_monitor;
GRANT EXECUTE ON FUNCTION kagent.pending_claims() TO pg_monitor;
RESET ROLE;
