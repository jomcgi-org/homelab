load("//tools/buck2/apko:defs.bzl", "apko_image")

# Self-contained example: a minimal Wolfi image built entirely from apk packages
# (no dependency on any external service binary), so it builds & validates in CI
# on its own and exercises the apko_image rule end to end.
apko_image(
    name = "hello",
    config = "apko.yaml",
    lock = "apko.lock.json",
)

# Build-time validation (runs under `buck2 build //tools/buck2/...`): assert the
# output tar is a multi-arch OCI index carrying both amd64 and arm64 manifests.
genrule(
    name = "hello-validate",
    srcs = [":hello"],
    out = "ok",
    cmd = " && ".join([
        "mkdir -p \"$TMP/x\"",
        "tar -xf $(location :hello) -C \"$TMP/x\" index.json",
        "grep -q amd64 \"$TMP/x/index.json\"",
        "grep -q arm64 \"$TMP/x/index.json\"",
        "touch $OUT",
    ]),
)
