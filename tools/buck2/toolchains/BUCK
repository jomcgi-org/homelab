load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("@prelude//toolchains:cxx.bzl", "system_cxx_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load(":cxx_dist.bzl", "hermetic_cxx_tools")
load(":rust_dist.bzl", "hermetic_rust_toolchain")

# Minimal `toolchains` cell for homelab's buck2 project. The image/helm rules in
# tools/buck2/** are CLI wrappers (apko/crane/helm/yq) built with `genrule`, so
# the genrule toolchain is the load-bearing one; the rest are system toolchains
# the prelude expects to resolve. No Rust/LLVM here — homelab doesn't compile
# native code under buck2 (cf. loom/toolchains/BUCK, which adds a hermetic Rust
# toolchain on top of these same system toolchains).

# Hermetic LLVM (same dist as loom) so `clang++`/`lld` are materialized for the
# link action rather than assumed present on the RE container.
LLVM_VERSION = "22.1.2"

http_archive(
    name = "llvm-x86_64-linux",
    urls = ["https://github.com/llvm/llvm-project/releases/download/llvmorg-{v}/LLVM-{v}-Linux-X64.tar.xz".format(v = LLVM_VERSION)],
    sha256 = "ff32497b6801267ee427bc69cdaeecfb2d19578af8c2a942e864c45215f9a2ac",
    strip_prefix = "LLVM-{}-Linux-X64".format(LLVM_VERSION),
    visibility = ["PUBLIC"],
)

hermetic_cxx_tools(
    name = "cxx-tools",
    llvm_dist = ":llvm-x86_64-linux",
    visibility = ["PUBLIC"],
)

system_cxx_toolchain(
    name = "cxx",
    _cxx_tools_info = ":cxx-tools",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)

# -- Hermetic Rust (same nightly + primitive as loom) -------------------------
# Mirrors loom's hermetic Rust toolchain so examples are representative. Targets
# x86_64-unknown-linux-gnu; linking is driven by the prelude's cxx toolchain
# (system `cc`, provided by build-essential in CI). Only the linux-x86_64 rustc
# dist is wired — Rust images build on linux (CI/RE), not on a macOS host. To
# bump: change RUST_NIGHTLY and refresh each sha256 from the matching
# `<file>.tar.xz.sha256` sidecar.
RUST_NIGHTLY = "2026-03-28"

_RUST_URL = "https://static.rust-lang.org/dist/{n}/{f}.tar.xz"

http_archive(
    name = "rustc-x86_64-linux",
    urls = [_RUST_URL.format(n = RUST_NIGHTLY, f = "rustc-nightly-x86_64-unknown-linux-gnu")],
    sha256 = "4ecbf56f21d311bc8aeb43a9f4ca6baf1a6612db7d45a9fce9f6c2b0770a9efd",
    strip_prefix = "rustc-nightly-x86_64-unknown-linux-gnu/rustc",
    visibility = ["PUBLIC"],
)

http_archive(
    name = "rust-std-x86_64-linux",
    urls = [_RUST_URL.format(n = RUST_NIGHTLY, f = "rust-std-nightly-x86_64-unknown-linux-gnu")],
    sha256 = "6e6e680502387637fd95cb02ea5abec6476e455c3e33f9c8cc83e1cdd62d5e66",
    strip_prefix = "rust-std-nightly-x86_64-unknown-linux-gnu/rust-std-x86_64-unknown-linux-gnu",
    visibility = ["PUBLIC"],
)

hermetic_rust_toolchain(
    name = "rust",
    rustc_dist = ":rustc-x86_64-linux",
    std_dist = ":rust-std-x86_64-linux",
    rustc_target_triple = "x86_64-unknown-linux-gnu",
    default_edition = "2024",
    rustc_flags = ["-Copt-level=2"],
    visibility = ["PUBLIC"],
)
