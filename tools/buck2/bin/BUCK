load(":defs.bzl", "pinned_cli")

# Pinned CLIs the buck2 image/helm rules wrap. To bump a tool: update its version
# and refresh the three sha256s (download the asset and `shasum -a 256`, or read
# the release's checksums sidecar). darwin wired arm64-only; macOS x86_64 hosts
# are unsupported.

# -- apko — Wolfi/distroless OCI image builder (chainguard-dev/apko) -----------
_APKO_V = "1.2.16"
_APKO_URL = "https://github.com/chainguard-dev/apko/releases/download/v{v}/apko_{v}_{os}_{arch}.tar.gz"

pinned_cli(
    name = "apko",
    binary = "apko",
    archive = "tar_strip1",  # apko_<v>_<os>_<arch>/apko
    urls = {
        "darwin-arm64": _APKO_URL.format(v = _APKO_V, os = "darwin", arch = "arm64"),
        "linux-amd64": _APKO_URL.format(v = _APKO_V, os = "linux", arch = "amd64"),
        "linux-arm64": _APKO_URL.format(v = _APKO_V, os = "linux", arch = "arm64"),
    },
    shas = {
        "darwin-arm64": "9c969bfd19bf9ed80dfe58f1dff839390b1d3ecc8362ba05fcc1d109c75ee52b",
        "linux-amd64": "d5ac99bd37c0e00e1f732ecf2f5e83e8b3f93b748ec692b30cd848ac2160f726",
        "linux-arm64": "ac3dbf12e84ff8e4d6b746e82077bd036277d206660a5a2d7bd0e7c7a5b05d0f",
    },
)

# -- crane — OCI registry tool (google/go-containerregistry) -------------------
