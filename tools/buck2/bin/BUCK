    name = "crane",
    binary = "crane",
    archive = "tar_root",  # crane at archive root
    urls = {
        "darwin-arm64": _CRANE_URL.format(v = _CRANE_V, tok = "Darwin_arm64"),
        "linux-amd64": _CRANE_URL.format(v = _CRANE_V, tok = "Linux_x86_64"),
        "linux-arm64": _CRANE_URL.format(v = _CRANE_V, tok = "Linux_arm64"),
    },
    shas = {
        "darwin-arm64": "a124f297d1e63e8b6c63c2463e43565290d2fd074c1dadb5ca73d737bc7b2484",
