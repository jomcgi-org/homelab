{
  "cleanupPeriodDays": 60,
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cd /tmp/claude-worktrees:*)",
      "Bash(cd /private/tmp/claude-worktrees:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git worktree:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git -C:*)",
      "Bash(gh:*)",
      "Bash(bazelisk:*)",
      "Bash(format:*)",
      "Bash(helm template:*)",
      "Bash(helm lint:*)",
      "Bash(helm dependency:*)",
      "Bash(helm show:*)",
      "Bash(helm uninstall:*)",
      "Bash(kubectl explain:*)",
      "Bash(kubectl label:*)",
      "Bash(kubectl api-resources:*)",
      "Bash(go:*)",
      "Bash(operator-sdk:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(lstr:*)",
      "Bash(tree:*)",
      "Bash(jq:*)",
      "Bash(crane:*)",
      "Bash(wc:*)",
      "Bash(column:*)",
      "WebFetch(domain:*)",
      "Bash(bb:*)",
      "mcp__buildbuddy",
      "mcp__homelab__monolith-answer-gap",
      "mcp__homelab__monolith-create-atom",
      "mcp__homelab__monolith-create-note",
      "mcp__homelab__monolith-delete-note",
      "mcp__homelab__monolith-edit-note",
      "mcp__homelab__monolith-get-daily-tasks",
      "mcp__homelab__monolith-get-note",
      "mcp__homelab__monolith-get-raw",
      "mcp__homelab__monolith-get-review-queue",
      "mcp__homelab__monolith-get-weekly-tasks",
      "mcp__homelab__monolith-k8s-get-events",
      "mcp__homelab__monolith-k8s-get-pod-logs",
      "mcp__homelab__monolith-k8s-get-resource",
      "mcp__homelab__monolith-k8s-health-summary",
      "mcp__homelab__monolith-k8s-list-resources",
      "mcp__homelab__monolith-k8s-sync-argocd-app",
      "mcp__homelab__monolith-list-gaps",
      "mcp__homelab__monolith-list-raws-needing-decomposition",
      "mcp__homelab__monolith-list-tasks",
      "mcp__homelab__monolith-monolith-agent-acquire-lock",
      "mcp__homelab__monolith-monolith-agent-check-dead-letters",
      "mcp__homelab__monolith-monolith-agent-check-firing-alerts",
      "mcp__homelab__monolith-monolith-agent-check-orphan-jobs",
      "mcp__homelab__monolith-monolith-agent-check-stuck-jobs",
      "mcp__homelab__monolith-monolith-agent-claim-routine-job",
      "mcp__homelab__monolith-monolith-agent-complete-routine-job",
      "mcp__homelab__monolith-monolith-agent-deregister-routine-job",
      "mcp__homelab__monolith-monolith-agent-extend-lock",
      "mcp__homelab__monolith-monolith-agent-list-locks",
      "mcp__homelab__monolith-monolith-agent-list-routine-jobs",
      "mcp__homelab__monolith-monolith-agent-notify",
      "mcp__homelab__monolith-monolith-agent-register-routine-job",
      "mcp__homelab__monolith-monolith-agent-release-lock",
      "mcp__homelab__monolith-monolith-agent-trigger-job",
      "mcp__homelab__monolith-monolith-agent-trigger-routine-job",
      "mcp__homelab__monolith-record-provenance",
      "mcp__homelab__monolith-search-knowledge",
      "mcp__homelab__monolith-search-tasks",
      "mcp__homelab__monolith-set-gap-class",
      "mcp__homelab__monolith-update-task"
    ],
    "additionalDirectories": ["/tmp/claude-worktrees"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/git/check-stale-pr.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/prefer-bb-remote.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/pretooluse-write-edit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-unnecessary-chart-bump.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-python-file-shadows-package.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-bdd-shared-testing-dep.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-deployment-component-label.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-hardcoded-model-subprocess.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-allowed-tools-prompt-sync.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-mcp-docstring-forbidden-patterns.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-migration-timestamp-order.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-constant-change-test-grep.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-public-route-visibility-filter.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-semgrep-rule-has-fixture.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-semgrep-helm-fixture-has-template-syntax.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-semgrep-exclude-coverage.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-public-svelte-notepanel-apibase.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-sveltekit-duplicate-api-base.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-classifier-version-bump.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-oci-values-image-tag.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-chart-version-targetrevision-sync.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-bare-nosemgrep.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-asyncio-mark-build-dep.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-generated-file-edit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-em-dash.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-cfingress-httpcheck-url.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-lifespan-startup-mock-sync.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bazel/tools/hooks/check-large-migration-sql.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "impeccable@impeccable": true
  },
  "skillListingBudgetFraction": 0.02
}
