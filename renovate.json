{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency updates and lock maintenance",
  "labels": ["dependencies"],
  "timezone": "America/Vancouver",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "prCreation": "immediate"
  },
  "enabledManagers": [
    "argocd",
    "bazel-module",
    "bazelisk",
    "custom.regex",
    "dockerfile",
    "github-actions",
    "gomod",
    "helm-values",
    "helmv3",
    "kubernetes",
    "npm",
    "pep621"
  ],
  "argocd": {
    "managerFilePatterns": ["/projects/.+/application\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the self-hosted Renovate runner image.",
      "managerFilePatterns": ["/projects/platform/renovate/values\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+tag: \\\"?(?<currentValue>[^\\s\\\"]+)\\\"?"
      ],
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Identify upstream chart updates in the broader dependency stream.",
      "matchManagers": ["argocd", "helmv3"],
      "addLabels": ["upstream-chart"]
    },
    {
      "description": "Keep committed Helm lock files and subchart archives synchronized.",
      "matchManagers": ["helmv3"],
      "postUpdateOptions": ["helmUpdateSubChartArchives"],
      "postUpgradeTasks": {
        "commands": [
          "bash projects/platform/renovate/scripts/bump-renovated-chart.sh {{{packageFileDir}}}"
        ],
        "fileFilters": [
          "**/Chart.yaml",
          "**/Chart.lock",
          "**/application.yaml",
          "**/charts/*.tgz"
        ],
        "executionMode": "update"
      }
    },
    {
      "description": "Regenerate Bazel's compiled Python requirement locks after pyproject updates.",
      "matchManagers": ["pep621"],
      "postUpgradeTasks": {
        "commands": ["bazel/tools/format/update-python-requirements.sh"],
        "fileFilters": ["pyproject.toml", "bazel/requirements/*.txt"],
        "executionMode": "branch"
      }
    },
    {
      "description": "Bump the Renovate wrapper chart when its runner image changes.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "postUpgradeTasks": {
        "commands": [
          "bash projects/platform/renovate/scripts/bump-renovated-chart.sh projects/platform/renovate"
        ],
        "fileFilters": [
          "projects/platform/renovate/Chart.yaml",
          "projects/platform/renovate/values.yaml"
        ],
        "executionMode": "update"
      }
    },
    {
      "description": "First-party charts are owned by chart-version-bot, never Renovate.",
      "matchDepNames": [
        "monolith",
        "mcp-stack",
        "agent-platform",
        "cluster-agents",
        "lakehouse",
        "oci-model-cache-operator"
      ],
      "enabled": false
    },
    {
      "description": "Self-referential git sources (deploy values pulled from our own repo) are not upgrade targets.",
      "matchDepNames": [
        "https://github.com/jomcgi/homelab",
        "https://github.com/jomcgi/homelab.git"
      ],
      "enabled": false
    },
    {
      "description": "Patch and minor updates may merge only after release-age checks and required CI pass.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Keep major upgrades as separate, clearly labelled PRs for human review.",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-upgrade"],
      "automerge": false
    }
  ]
}
