+const nativeModule = (() => {
+	const localPath = path.join(__dirname, localName);
+	if (existsSync(localPath)) return require(localPath);
+	try {
+		return requireWithFriendlyError(`@rollup/rollup-${packageBase}`);
+	} catch {
+		// Fallback for sandboxed build environments (e.g. Bazel) where the
+		// platform-specific native module is linked in the workspace node_modules
+		// rather than in rollup's own virtual store node_modules.
+		return require(require.resolve(`@rollup/rollup-${packageBase}`, {
+			paths: [path.join(process.cwd(), 'node_modules')]
+		}));
+	}
+})();
 
