; OVERLAY: generate the OCaml grammar with Menhir's table backend.
;
; The code backend requires type inference for this grammar's implicit
; nonterminal types. In the hermetic Bazel action that inference query cannot
; compile before the parser itself exists. The table backend generates the
; parser directly, as upstream already does for JavaScript, and requires the
; corresponding checksum-locked menhirLib runtime dependency.
(library
 (public_name parser_ocaml.menhir)
 (name parser_ocaml_menhir)
 (wrapped false)
 (libraries
  menhirLib
  commons
  lib_parsing
  parser_ocaml.ast)
 (preprocess (pps ppx_deriving.show)))
(ocamllex lexer_ml)
(menhir
 (modules parser_ml)
 (flags --unused-tokens --explain --table --fixed-exception))
