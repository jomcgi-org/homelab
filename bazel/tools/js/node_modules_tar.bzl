"""node_modules_tar - package rules_js node_modules trees for images."""

load("@aspect_rules_js//js:providers.bzl", "JsInfo")

def _node_modules_tar_impl(ctx):
    npm_sources = depset(transitive = [dep[JsInfo].npm_sources for dep in ctx.attr.deps])
    output = ctx.actions.declare_file(ctx.label.name + ".tar")
    arguments = ctx.actions.args()
    arguments.add(output.path)

    for source in npm_sources.to_list():
        marker = "node_modules/"
        marker_index = source.short_path.find(marker)
        if marker_index == -1:
            # JsInfo may carry first-party sources alongside the linked npm
            # package graph. They belong to their owning Bazel target, not in
            # the image's node_modules tree.
            continue

        relative_path = source.short_path[marker_index + len(marker):]
        if not relative_path or relative_path.startswith("../"):
            fail("invalid npm source path: {}".format(source.short_path))

        arguments.add(source.path)
        arguments.add(relative_path)

    ctx.actions.run_shell(
        inputs = npm_sources,
        outputs = [output],
        arguments = [arguments],
        command = """
set -euo pipefail

output="$1"
shift
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
node_modules="$stage{package_dir}"
mkdir -p "$node_modules"

while [ "$#" -gt 0 ]; do
    source="$1"
    relative_path="$2"
    shift 2
    destination="$node_modules/$relative_path"
    mkdir -p "$(dirname "$destination")"

    if [ -L "$source" ]; then
        resolved_target=$(readlink -f "$source")
        rm -rf -- "$destination"
        case "$resolved_target" in
            */node_modules/*)
                # Rebase links from Bazel's output tree into the image tree.
                target_relative="${{resolved_target#*/node_modules/}}"
                staged_target="$node_modules/$target_relative"
                link_target=$(realpath -m \
                    --relative-to="$(dirname "$destination")" \
                    "$staged_target")
                ln -s "$link_target" "$destination"
                ;;
            *)
                # A first-party linked source has no package-store destination.
                if [ -d "$source" ]; then
                    mkdir -p "$destination"
                    cp -aL "$source/." "$destination/"
                else
                    cp -aL "$source" "$destination"
                fi
                ;;
        esac
    elif [ -d "$source" ]; then
        mkdir -p "$destination"
        cp -a "$source/." "$destination/"
    else
        cp -aT "$source" "$destination"
    fi
done

# Materialize top-level package roots only after every duplicate JsInfo path has
# been staged. The versioned pnpm store remains intact, while package entry
# points no longer depend on Bazel output-tree symlink semantics.
for package in "$node_modules"/*; do
    [ -d "$package" ] || continue
    materialized=$(mktemp -d "$stage/materialized.XXXXXX")
    cp -aL "$package/." "$materialized/"
    rm -- "$package"
    mkdir -p "$package"
    cp -a "$materialized/." "$package/"
    rm -rf -- "$materialized"
done

# Keep the rules_js pnpm store and its relative links intact. Flattening the
# package tree by name loses distinct versions required by different consumers.
tar -C "$stage" -czf "$output" .
""".format(package_dir = ctx.attr.package_dir),
        mnemonic = "NodeModulesTar",
        progress_message = "Packaging pnpm dependency graph for {}".format(ctx.label),
    )

    return [DefaultInfo(files = depset([output]))]

_node_modules_tar = rule(
    implementation = _node_modules_tar_impl,
    attrs = {
        "deps": attr.label_list(
            mandatory = True,
            providers = [JsInfo],
        ),
        "package_dir": attr.string(mandatory = True),
    },
)

def node_modules_tar(
        name,
        deps,
        package_dir = "/usr/local/lib/node_modules",
        visibility = None):
    """Package a rules_js pnpm graph into a tar without flattening versions.

    Args:
        name: Name of the tar target.
        deps: rules_js package link targets to include.
        package_dir: Destination node_modules path in the image.
        visibility: Visibility of the generated tar.
    """
    if not package_dir.startswith("/") or package_dir == "/":
        fail("package_dir must be an absolute path below the image root")

    _node_modules_tar(
        name = name,
        deps = deps,
        package_dir = package_dir,
        visibility = visibility,
    )
