#!/usr/bin/env bash
# ci: local feedback loop that matches PR CI so Workflows mostly cache-hit.
#
# Steps:
#   1. lint   format only files changed vs origin/main
#   2. regen  generators/gazelle only when their inputs changed
#   3. test   bb remote (Linux) bazel test with the same flags as buildbuddy.yaml "Test"
#
# Usage:
#   ci              # lint + regen + remote test
#   ci lint         # format changed files only
#   ci regen        # selective generators (+ gazelle when go/py/BUILD changed)
#   ci test         # bb remote test only (optional: ci test -- //path:target ...)
#   ci --help
#
# Env:
#   CI_BASE_REF     git ref to diff against (default: origin/main)
#   SKIP_REMOTE=1   skip the remote test step when running full `ci`
#
# Test flags are locked to buildbuddy.yaml "Test" for action-cache sharing:
#   test //... --config=ci --deleted_packages=bazel/tools/python --test_tag_filters=-external,-future
#
# Secrets: `ci test` passes include-secrets=true so the remote runner matches CI
# (Docker Hub etc.). That widens org secrets from CI-only runners to any local
# `ci test` (including agent-driven). Treat the working tree as CI-equivalent.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT" ]]; then
	echo "ci: not inside a git work tree" >&2
	exit 1
fi
cd "$ROOT"

if [[ -d "$ROOT/.tools/bin" ]]; then
	export PATH="$ROOT/.tools/bin:$PATH"
fi
if [[ -d "${XDG_CACHE_HOME:-$HOME/.cache}/homelab-tools/usr/bin" ]]; then
	export PATH="${XDG_CACHE_HOME:-$HOME/.cache}/homelab-tools/usr/bin:$PATH"
fi

BASE_REF="${CI_BASE_REF:-origin/main}"
GREEN=$'\033[0;32m'
RED=$'\033[0;31m'
DIM=$'\033[0;2m'
NC=$'\033[0m'
log() { printf '%s▶%s %s\n' "$GREEN" "$NC" "$*"; }
err() { printf '%s✗%s %s\n' "$RED" "$NC" "$*" >&2; }
dim() { printf '%s%s%s\n' "$DIM" "$*" "$NC"; }

usage() {
	sed -n '2,/^set -euo pipefail$/p' "$0" | sed '$d' | sed 's/^# \?//'
}

# Changed paths vs merge-base with BASE_REF, plus unstaged and staged worktree edits.
changed_files() {
	local base
	if git rev-parse --verify "$BASE_REF" >/dev/null 2>&1; then
		base="$(git merge-base HEAD "$BASE_REF" 2>/dev/null || echo "$BASE_REF")"
	else
		base="HEAD"
	fi
	{
		git diff --name-only --diff-filter=ACMR "$base" 2>/dev/null || true
		git diff --name-only --diff-filter=ACMR 2>/dev/null || true
		git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true
	} | sed '/^$/d' | sort -u
}

# True if any changed path is "code" (not pure docs/agent prose). Used by pre-push.
code_changed() {
	local f
	while IFS= read -r f; do
		case "$f" in
		docs/* | .claude/* | *.md | */*.md) continue ;;
		"") continue ;;
		*) return 0 ;;
		esac
	done < <(changed_files)
	return 1
}

# ---------- lint (file-selective format) ----------
# Extension list matches what PATH prettier/ruff/etc. can format. *.svelte needs
# prettier-plugin-svelte (wired in bazel/tools/format/prettier.config.cjs); pass
# --config so PATH prettier loads the plugin the same way the Bazel binary does.
PRETTIER_CONFIG="${PRETTIER_CONFIG:-bazel/tools/format/prettier.config.cjs}"
cmd_lint() {
	local -a files=()
	local f
	while IFS= read -r f; do
		[[ -n "$f" && -f "$f" ]] && files+=("$f")
	done < <(changed_files)

	if [[ ${#files[@]} -eq 0 ]]; then
		log "lint: no changed files vs $BASE_REF"
		return 0
	fi

	local -a py=() sh=() go=() star=() pretty=()
	for f in "${files[@]}"; do
		case "$f" in
		*.py) py+=("$f") ;;
		*.sh) sh+=("$f") ;;
		*.go) go+=("$f") ;;
		BUILD | BUILD.bazel | *.bzl | WORKSPACE | WORKSPACE.bazel | */BUILD | */BUILD.bazel)
			star+=("$f")
			;;
		*.js | *.jsx | *.ts | *.tsx | *.mjs | *.cjs | *.json | *.yaml | *.yml | *.md | *.css | *.html | *.svelte)
			pretty+=("$f")
			;;
		esac
	done

	log "lint: ${#files[@]} changed file(s)"
	local missing=0
	for tool in ruff shfmt gofumpt prettier; do
		if ! command -v "$tool" >/dev/null 2>&1; then
			err "missing tool: $tool (run ./bootstrap.sh && direnv allow)"
			missing=1
		fi
	done
	[[ $missing -eq 0 ]] || exit 1

	[[ ${#py[@]} -gt 0 ]] && {
		dim "  ruff format (${#py[@]})"
		ruff format "${py[@]}"
	}
	[[ ${#sh[@]} -gt 0 ]] && {
		dim "  shfmt (${#sh[@]})"
		shfmt -w "${sh[@]}"
	}
	[[ ${#go[@]} -gt 0 ]] && {
		dim "  gofumpt (${#go[@]})"
		gofumpt -w "${go[@]}"
	}
	[[ ${#pretty[@]} -gt 0 ]] && {
		dim "  prettier (${#pretty[@]})"
		prettier --config "$PRETTIER_CONFIG" --write "${pretty[@]}" >/dev/null
	}
	if [[ ${#star[@]} -gt 0 ]]; then
		if command -v buildifier >/dev/null 2>&1; then
			dim "  buildifier (${#star[@]})"
			buildifier "${star[@]}"
		else
			dim "  buildifier skipped (not on PATH; CI format will cover BUILD files)"
		fi
	fi
	log "lint: done"
}

# ---------- regen (file-selective generators + gazelle) ----------
need_generators() {
	local f
	while IFS= read -r f; do
		case "$f" in
		projects/*/deploy/* | projects/home-cluster/* | bazel/images/* | projects/*/image/*)
			return 0
			;;
		projects/monolith/generate-routes.sh | projects/monolith/*/router.py | \
			projects/monolith/*/module.py | projects/monolith/knowledge/tools/* | \
			projects/monolith/chat/* | \
			projects/firecracker/*/guest/apko.lock.json | \
			projects/firecracker/*/guest/env-notes.md)
			return 0
			;;
		*.md | */*.md) return 0 ;;
		*/deploy/application.yaml | */deploy/kustomization.yaml | */apko.yaml | */apko.lock.json)
			return 0
			;;
		esac
	done < <(changed_files)
	return 1
}

need_gazelle() {
	local f
	while IFS= read -r f; do
		case "$f" in
		*.go | *.py | BUILD | BUILD.bazel | */BUILD | */BUILD.bazel | *.bzl)
			return 0
			;;
		esac
	done < <(changed_files)
	return 1
}

need_migration_check() {
	local f
	while IFS= read -r f; do
		case "$f" in
		*/migrations/*.sql) return 0 ;;
		esac
	done < <(changed_files)
	return 1
}

cmd_regen() {
	if need_generators; then
		log "regen: running generators (inputs changed)"
		./bazel/tools/format/run-generators.sh
	else
		log "regen: generators skipped (no matching inputs)"
	fi

	if need_gazelle; then
		if command -v gazelle >/dev/null 2>&1; then
			log "regen: gazelle"
			gazelle
		else
			dim "regen: gazelle not on PATH; skipped"
		fi
	else
		log "regen: gazelle skipped"
	fi

	if need_migration_check; then
		log "regen: migration ordering check"
		./bazel/tools/format/check-migration-ordering.sh
	fi
	log "regen: done"
}

# ---------- test (bb remote = Workflows backend, Linux) ----------
# MUST stay byte-for-byte identical to buildbuddy.yaml action "Test" so the
# remote action cache is shared with PR CI (cache hits = green PR immediately).
# Workflows Test runs:
#   bazel test //... --config=ci --deleted_packages=bazel/tools/python --test_tag_filters=-external,-future
cmd_test() {
	# Parse args before requiring bb so unit tests can validate flag rejection
	# in hermetic sandboxes that do not install the BuildBuddy CLI.
	local -a targets=()
	local -a extra=()
	local saw_ddash=0
	local a
	for a in "$@"; do
		if [[ $saw_ddash -eq 1 ]]; then
			extra+=("$a")
			continue
		fi
		if [[ "$a" == "--" ]]; then
			saw_ddash=1
			continue
		fi
		if [[ "$a" == -* ]]; then
			err "ci test: unexpected flag '$a' (would break CI argv parity)."
			err "Usage: ci test                  # full //... like Workflows Test"
			err "       ci test -- //pkg:tgt     # focused targets (same --config flags)"
			exit 2
		fi
		targets+=("$a")
	done

	if ! command -v bb >/dev/null 2>&1; then
		err "bb (BuildBuddy CLI) not found. Install: https://www.buildbuddy.io/cli/"
		exit 1
	fi

	local -a bazel_args=(test)
	if [[ ${#targets[@]} -eq 0 ]]; then
		bazel_args+=(//...)
	else
		bazel_args+=("${targets[@]}")
	fi
	bazel_args+=(
		--config=ci
		--deleted_packages=bazel/tools/python
		--test_tag_filters=-external,-future
	)
	[[ ${#extra[@]} -gt 0 ]] && bazel_args+=("${extra[@]}")

	log "test: bb remote (linux/amd64) 1:1 with buildbuddy.yaml Test"
	dim "  bb remote --os=linux --arch=amd64 ${bazel_args[*]}"
	dim "  (include-secrets=true: runner may receive org secrets; treat as CI)"

	# Match the Test action's `resource_requests` in buildbuddy.yaml: disk 120GB,
	# cpu 8, memory 10GB.
	#
	# Parity with CI was previously argv-only: targets, --config, --deleted_packages
	# and --test_tag_filters all matched, but resource requests live in the YAML
	# rather than the bazel command line, so they were never mirrored and this path
	# silently took the much smaller default runner disk. //... pulls an external
	# tree over 11G (apko layers, the semgrep_pro OCI archive, pip wheels, npm), so
	# the default fills and the build dies mid-fetch with "No space left on device"
	# on whichever repository happened to be unpacking. It presents as flakiness:
	# the failing target moves between runs, and it is never the target you changed.
	# Confirmed not to be runner-recycling debris; a fresh runner
	# (recycle-runner=false) ran out of disk the same way.
	#
	# CPU and memory are the same omission, one step further on. The images apko
	# builds are `no-remote-exec` (rules_apko sets it), so they run ON the runner
	# rather than on RBE and their concurrency is capped by its cores, not by
	# --jobs. A default-sized runner therefore serialises the slowest part of a
	# cold //... here while CI runs it 8-wide, which is the opposite of what "1:1
	# with the Test action" claims.
	#
	# Memory is raised alongside deliberately, not for its own sake: 8 concurrent
	# apko builds on a default memory allowance is how you trade a slow run for an
	# OOM. The pair matches buildbuddy.yaml rather than being tuned independently.
	#
	# Property names are exact and case-insensitive on lookup: EstimatedCPU takes
	# cores or an `m` suffix, EstimatedMemory takes an IEC string. A typo here does
	# NOT fail, it silently falls back to the default (milliCPUProp/iecBytesProp
	# return defaultValue on a parse error), so changing these means re-reading the
	# runner's actual size rather than trusting the flag went through.
	local out
	out="$(mktemp)"
	trap 'rm -f "${out:-}"' RETURN INT TERM
	local bb_status=0
	local esc=$'\x1b'
	bb remote --os=linux --arch=amd64 \
		--runner_exec_properties=include-secrets=true \
		--runner_exec_properties=EstimatedFreeDiskBytes=120GB \
		--runner_exec_properties=EstimatedCPU=8 \
		--runner_exec_properties=EstimatedMemory=10GB \
		"${bazel_args[@]}" 2>&1 | tee "$out" || bb_status=$?

	# bb remote exits 0 when the remote ACTION fails, so require positive evidence
	# of a test summary before accepting (#4118). Diagnose red test runs before
	# runner failures because a genuine red run can include both outputs.
	if grep -qE 'Executed [0-9]+ out of [0-9]+ tests?' "$out"; then
		if grep -qE 'Executed [0-9]+ out of [0-9]+ tests?.* fail' "$out" ||
			grep -qE "(^|${esc}\[[0-9;]*m)//[^ ]+ +(FAILED|TIMEOUT) in" "$out"; then
			err "the run reported test failures, so this is a red run, not an infra failure"
			return 1
		fi
	fi
	if grep -qE "(^|${esc}\[[0-9;]*m)(Action failed:|Command failed: exit status)" "$out"; then
		err "remote runner failed before or while running tests (see output above, issue #4118)"
		return 1
	fi
	if ! grep -qE 'Executed [0-9]+ out of [0-9]+ tests?' "$out"; then
		if grep -qF 'Multiple entries with same key: Range' "$out"; then
			local apk_url
			apk_url="$(sed -nE 's/.*Download from ([^[:space:]]+) failed:.*/\1/p' "$out" | head -n 1)"
			if [[ -n "$apk_url" ]]; then
				err "duplicate Range in apk download for $apk_url"
			else
				err "duplicate Range in apk download"
			fi
			dim "the build aborted before any test ran; re-running usually succeeds (issue #4849)"
		fi
		err "no bazel test summary was found, so nothing was verified (issue #4118)"
		if [[ "$bb_status" -ne 0 ]]; then
			return "$bb_status"
		fi
		return 1
	fi
	return "$bb_status"
}

cmd_all() {
	cmd_lint
	cmd_regen
	if [[ "${SKIP_REMOTE:-0}" == "1" ]]; then
		log "test: skipped (SKIP_REMOTE=1)"
		return 0
	fi
	cmd_test "$@"
}

main() {
	local cmd="${1:-}"
	case "$cmd" in
	"" | all)
		[[ "$cmd" == "all" ]] && shift || true
		cmd_all "$@"
		;;
	lint)
		shift
		cmd_lint "$@"
		;;
	regen)
		shift
		cmd_regen "$@"
		;;
	test)
		shift
		cmd_test "$@"
		;;
	-h | --help | help)
		usage
		;;
	*)
		err "unknown command: $cmd (try: ci | ci lint | ci regen | ci test)"
		exit 2
		;;
	esac
}

main "$@"
