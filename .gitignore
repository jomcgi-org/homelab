# User-specific settings file for this repo
user.bazelrc

# Don't check in lockfile for now. It is unstable.
# https://github.com/bazelbuild/bazel/issues/19026
# https://github.com/bazelbuild/bazel/issues/19621
# https://github.com/bazelbuild/bazel/issues/19971
# https://github.com/bazelbuild/bazel/issues/20272
# https://github.com/bazelbuild/bazel/issues/20369
MODULE.bazel.lock

# Symlinks created by Bazel into the output tree
/bazel-*

# Stray binary from running `go build ./cmd/...` at the repo root, which names
# its output after the package directory. Anchored: a bare `cmd` would match the
# many legitimate cmd/ package directories under projects/.
/cmd

node_modules/
dist/
# Local jomcgi.dev preview output (projects/jomcgi-site/preview/preview.sh).
projects/jomcgi-site/preview/out/

*.venv/
__pycache__
*.sqlite
*.sqlite.db

# Rendered manifests - ArgoCD renders at deploy time, no need to commit
**/manifests/

# Local logs
logs/

# Environment files (keep .env.example templates)
.env
.env.local
.env.*.local

# Secrets and credentials
*.pem
*.key
*.p12
*.pfx
credentials.json
kubeconfig
*.kubeconfig
**/.claude/settings.local.json
.claude/scheduled_tasks.lock
.mcp.local.json

# OS files
.DS_Store
Thumbs.db

# Editor files
.idea/
*.swp
.ruff_cache/

# Bazel remote-build output dir (bb remote). A stray binary here was committed
# once and broke BuildBuddy git sync, blocking every push.
bb-out/

# Chart versions published by main's push, handed to write-back-versions.sh
# (ADR platform/009 decision 1). Written by bazel/helm/push.sh.tpl, consumed and
# deleted in the same CI action, never committed.
.chart-version-records/

# Local fixture-preview build output for the Grimoire web app.
dist-preview/
