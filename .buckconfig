# buck2 project root for homelab's Buck2 build rules (tools/buck2/**).
#
# homelab is primarily a Bazel monorepo; this .buckconfig adds a *second*,
# self-contained buck2 project rooted here so the reusable image/helm rules in
# tools/buck2/ can be developed and tested in place. buck2 reads `BUCK` files,
# Bazel reads `BUILD`/`BUILD.bazel`, so the two coexist without collision; the
# buck2 prelude submodule is excluded from Bazel via .bazelignore.
#
# Pinned to the same buck2 release (2026-05-18) + prelude commit as the `loom`
# repo, which consumes tools/buck2 as an external cell — keep them aligned.
#
# Execution is LOCAL only for now (no buck2 RE): builds run in the BuildBuddy
# workflow container. To enable RE later, add [project] remote_enabled = true
# and a [buck2_re_client] block (see loom/.buckconfig) — platforms/defs.bzl
# already branches on project.remote_enabled.

[cells]
  root = .
  prelude = prelude
  toolchains = tools/buck2/toolchains
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default

[build]
  execution_platforms = root//tools/buck2/platforms:default

[buck2]
  digest_algorithms = SHA256
